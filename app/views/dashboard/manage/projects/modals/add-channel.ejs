<!-- New Channel Modal -->
<div
  id="newChannelModal"
  class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
>
  <div
    class="relative top-20 mx-auto p-5 border w-full max-w-md shadow-lg rounded-lg bg-gray-800 border-gray-700"
  >
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">Add New Channel</h3>
      <button
        onclick="closeNewChannelModal()"
        class="text-gray-400 hover:text-white transition-colors"
      >
        <i class="ti ti-x text-2xl"></i>
      </button>
    </div>

    <form id="newChannelForm" class="space-y-4">
      <div>
        <label
          for="channel_name"
          class="block text-sm font-medium text-gray-300 mb-2"
        >
          Channel Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="channel_name"
          name="channel_name"
          required
          class="w-full px-4 py-2 bg-gray-700 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="e.g., My YouTube Channel"
        />
      </div>

      <div>
        <label
          for="platform"
          class="block text-sm font-medium text-gray-300 mb-2"
        >
          Platform <span class="text-red-500">*</span>
        </label>
        <select
          id="platform"
          name="platform"
          required
          class="w-full px-4 py-2 pr-8 bg-gray-700 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Select platform...</option>
          <option value="youtube">YouTube</option>
          <option value="facebook">Facebook</option>
          <option value="instagram">Instagram</option>
          <option value="twitch">Twitch</option>
          <option value="tiktok">TikTok</option>
        </select>
      </div>

      <div>
        <label
          for="external_id"
          class="block text-sm font-medium text-gray-300 mb-2"
        >
          External ID (Optional)
        </label>
        <input
          type="text"
          id="external_id"
          name="external_id"
          class="w-full px-4 py-2 bg-gray-700 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="e.g., Channel ID or Username"
        />
        <p class="mt-1 text-xs text-gray-400">
          You can add this later when connecting OAuth
        </p>
      </div>

      <div class="flex items-center space-x-3 pt-4">
        <button
          type="button"
          onclick="closeNewChannelModal()"
          class="flex-1 px-4 py-2 border border-gray-600 rounded-lg text-sm font-medium text-gray-300 bg-gray-700 hover:bg-gray-600 transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="flex-1 px-4 py-2 bg-blue-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-blue-700 transition-colors"
        >
          Create Channel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Modal Controls
  function openNewChannelModal() {
    document.getElementById("newChannelModal").classList.remove("hidden");
  }

  function closeNewChannelModal() {
    document.getElementById("newChannelModal").classList.add("hidden");
    document.getElementById("newChannelForm").reset();
  }

  // Close modal when clicking outside
  document
    .getElementById("newChannelModal")
    ?.addEventListener("click", function (e) {
      if (e.target === this) {
        closeNewChannelModal();
      }
    });

  // Close modal with Escape key
  document.addEventListener("keydown", function (e) {
    if (
      e.key === "Escape" &&
      !document.getElementById("newChannelModal").classList.contains("hidden")
    ) {
      closeNewChannelModal();
    }
  });

  // Create New Channel
  document
    .getElementById("newChannelForm")
    ?.addEventListener("submit", async function (e) {
      e.preventDefault();

      const formData = {
        projectUuid: "<%= project.project_uuid %>",
        channelPlatform: document.getElementById("platform").value,
        channelName: document.getElementById("channel_name").value,
        externalId: document.getElementById("external_id").value || null,
      };

      try {
        const response = await fetch("/api/channels", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(formData),
        });

        const result = await response.json();

        if (response.ok) {
          alert("Channel created successfully!");
          window.location.reload();
        } else {
          alert("Error: " + (result.message || "Failed to create channel"));
        }
      } catch (error) {
        console.error("Error creating channel:", error);
        alert("An error occurred while creating the channel");
      }
    });

  // Edit Project
  function editProject() {
    // TODO: Implement edit project modal
    openEditProjectModal();
  }

  // Edit Channel
  function editChannel(channelUuid) {
    // TODO: Implement edit channel modal
    alert("Edit channel functionality will be implemented soon");
  }

  // Delete Channel
  function deleteChannel(channelUuid) {
    if (
      confirm(
        "Are you sure you want to delete this channel? This action cannot be undone."
      )
    ) {
      fetch(`/api/channels/${channelUuid}`, {
        method: "DELETE",
      })
        .then((response) => response.json())
        .then((result) => {
          if (result.success) {
            alert("Channel deleted successfully!");
            window.location.reload();
          } else {
            alert("Error: " + (result.message || "Failed to delete channel"));
          }
        })
        .catch((error) => {
          console.error("Error deleting channel:", error);
          alert("An error occurred while deleting the channel");
        });
    }
  }
</script>
