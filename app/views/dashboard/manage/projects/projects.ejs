<% layout('dashboard/layout') %>

<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %> <%- include('../../partials/sidebar')
  %>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto lg:ml-20 pt-[72px]">
    <div class="p-4 sm:p-5 lg:p-6">
      <!-- Header -->
      <div class="mb-5 sm:mb-6">
        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white">Projects</h2>
            <p class="text-gray-400 mt-1 text-sm sm:text-base">
              Manage your channel projects and workspaces
            </p>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto"
          >
            <div class="relative w-full sm:w-64">
              <span
                class="absolute inset-y-0 left-3 flex items-center text-gray-400"
              >
                <i class="ti ti-search"></i>
              </span>
              <input
                type="text"
                name="search"
                id="search"
                class="pl-9 pr-4 py-2 rounded-md bg-gray-800 text-gray-200 border border-gray-700 focus:outline-none focus:border-blue-500/50 transition w-full sm:w-64"
                placeholder="Search projects..."
                oninput="filterProjects(this.value)"
                autocomplete="off"
              />
            </div>
            <button
              onclick="openNewProjectModal()"
              class="flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition-colors text-sm sm:text-base whitespace-nowrap w-full sm:w-auto font-medium"
            >
              <i class="ti ti-plus"></i>
              <span>New Project</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Projects Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
        id="projectGrid"
      >
        <% if (projects.length === 0) { %>
        <!-- Empty State -->
        <div
          class="col-span-full bg-gray-900/30 border border-dashed border-gray-700 rounded-md p-10 text-center"
          id="projectEmptyState"
        >
          <div
            class="w-16 h-16 bg-gray-800/50 rounded-full flex items-center justify-center mx-auto mb-4 border border-gray-700"
          >
            <i class="ti ti-folder-plus text-4xl text-gray-600"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No Projects Yet</h3>
          <p
            class="text-gray-500 mb-8 max-w-sm mx-auto text-sm leading-relaxed"
          >
            Organize your channels and streaming assets by creating your first
            project. Start your journey today.
          </p>
          <button
            onclick="openNewProjectModal()"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-md transition-colors font-semibold"
          >
            <i class="ti ti-plus"></i>
            <span>Create First Project</span>
          </button>
        </div>
        <% } else { %> <% projects.forEach(function(project) { %>
        <!-- Project Card -->
        <a
          href="/projects/detail/<%= project.project_uuid %>"
          class="group bg-gray-800/40 hover:bg-gray-800/70 border border-gray-700/50 hover:border-gray-600 rounded-md p-4 sm:p-5 transition-colors flex flex-col h-full"
        >
          <div class="flex items-start justify-between mb-4">
            <div
              class="w-11 h-11 rounded-md bg-gray-900 border border-gray-700/50 flex items-center justify-center text-gray-500 group-hover:text-blue-400 group-hover:border-gray-600 transition-colors"
            >
              <i class="ti ti-folder text-2xl"></i>
            </div>
            <% const statusConfig = { active: { color: 'bg-green-500', text:
            'Active' }, inactive: { color: 'bg-gray-500', text: 'Inactive' },
            banned: { color: 'bg-red-500', text: 'Banned' } }; const status =
            statusConfig[project.status] || statusConfig.active; %>
            <div
              class="project-status-badge flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50"
              data-project-status="<%= project.status || 'active' %>"
            >
              <span class="w-1.5 h-1.5 rounded-full <%= status.color %>"></span>
              <span
                class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
                ><%= status.text %></span
              >
            </div>
          </div>

          <div class="flex-grow">
            <h3
              class="text-lg font-bold text-white mb-2 group-hover:text-blue-400 transition-colors line-clamp-1"
            >
              <%= project.project_name %>
            </h3>
            <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed mb-4">
              <%= project.description ? project.description : project.type ||
              'No description provided' %>
            </p>
          </div>

          <div
            class="mt-3 pt-4 border-t border-gray-700/30 flex items-center justify-between"
          >
            <div class="flex items-center gap-4">
              <div
                class="flex items-center gap-2 text-xs text-gray-500 font-medium"
              >
                <i class="ti ti-device-tv text-sm opacity-70"></i>
                <span><%= project.channel_count || 0 %> Channels</span>
              </div>
              <div
                class="flex items-center gap-2 text-xs text-gray-500 font-medium"
              >
                <i class="ti ti-calendar-event text-sm opacity-70"></i>
                <span
                  ><%= new
                  Date(project.created_at).toLocaleDateString(undefined, { year:
                  'numeric', month: 'short', day: 'numeric' }) %></span
                >
              </div>
            </div>
            <i
              class="ti ti-arrow-right text-gray-500 group-hover:text-blue-500 group-hover:translate-x-1 transition-all"
            ></i>
          </div>
        </a>
        <% }) %> <% } %>
      </div>

      <!-- Pagination -->
      <% if (projects.length > 0) { %>
      <div
        class="mt-6 space-y-3"
        style="display: none"
        id="projectPaginationContainer"
      >
        <div class="flex items-center justify-center gap-2 flex-wrap">
          <!-- Pagination Buttons -->
          <button
            onclick="changePage('prev')"
            class="w-10 h-10 flex items-center justify-center bg-gray-800 hover:bg-gray-700 rounded-md border border-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
            id="projectPrevBtn"
          >
            <i class="ti ti-chevron-left text-lg"></i>
          </button>

          <div id="projectPaginationNumbers" class="flex items-center gap-2">
            <!-- Page numbers will be generated by JavaScript -->
          </div>

          <button
            onclick="changePage('next')"
            class="w-10 h-10 flex items-center justify-center bg-gray-800 hover:bg-gray-700 rounded-md border border-gray-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
            id="projectNextBtn"
          >
            <i class="ti ti-chevron-right text-lg"></i>
          </button>
        </div>

        <!-- Showing Info -->
        <p class="text-center text-sm text-gray-400" id="projectShowingInfo">
          <!-- Info will be updated by JavaScript -->
        </p>
      </div>
      <% } %>
    </div>
  </main>
</div>

<script src="/js/projects.js"></script>
<%- include('./modals/add-project') %>

