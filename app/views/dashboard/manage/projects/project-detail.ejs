<% layout('dashboard/layout') %>

<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %>
  <%- include('../../partials/sidebar') %>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto lg:ml-20 pt-16">
    <div class="p-4 sm:p-6 lg:p-8">
    <!-- Header with Back Button -->
    <div class="bg-gray-800 border-b border-gray-700 rounded-lg mb-6">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between space-y-4 lg:space-y-0">
                <div class="flex items-center space-x-4">
                    <a href="/projects" class="text-gray-400 hover:text-white transition-colors rounded-full p-2 bg-gray-700 hover:bg-gray-600 shadow flex-shrink-0 w-10 h-10 flex items-center justify-center">
                        <i class="ti ti-arrow-left text-2xl"></i>
                    </a>
                    <div class="min-w-0 flex-1">
                        <h1 class="text-xl sm:text-2xl font-bold text-white truncate"><%= project.project_name %></h1>
                        <% if (project.description) { %>
                            <p class="text-sm text-gray-400 mt-1 line-clamp-2"><%= project.description %></p>
                        <% } %>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center space-y-3 sm:space-y-0 sm:space-x-3">
                    <button onclick="editProject()" class="inline-flex items-center justify-center px-4 py-2 border border-gray-600 rounded-lg text-sm font-medium text-gray-300 bg-gray-700 hover:bg-gray-600 transition-colors">
                        <i class="ti ti-edit mr-2"></i>
                        <span class="hidden xs:inline">Edit Project</span>
                        <span class="xs:hidden">Edit</span>
                    </button>
                    <button onclick="openNewChannelModal()" class="inline-flex items-center justify-center px-4 py-2 bg-blue-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-blue-700 transition-colors shadow-sm">
                        <i class="ti ti-plus mr-2"></i>
                        <span class="hidden xs:inline">Add Channel</span>
                        <span class="xs:hidden">Add</span>
                    </button>
                </div>
            </div>

            <!-- Project Stats -->
            <div class="flex flex-wrap items-center gap-3 sm:gap-6 mt-4 sm:mt-6">
                <div class="flex items-center text-sm text-gray-300 bg-gray-800 rounded-lg px-3 py-1 sm:px-4 sm:py-2 shadow">
                    <i class="ti ti-smart-home mr-2 flex-shrink-0"></i>
                    <span><%= channels.length %> Channel<%= channels.length !== 1 ? 's' : '' %></span>
                </div>
                <div class="flex items-center text-sm text-gray-300 bg-gray-800 rounded-lg px-3 py-1 sm:px-4 sm:py-2 shadow">
                    <i class="ti ti-calendar mr-2 flex-shrink-0"></i>
                    <span class="hidden sm:inline mr-1">Created </span><%= new Date(project.created_at).toLocaleDateString() %></span>
                </div>
                <div class="flex items-center">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                        <%= project.status === 'active' ? 'bg-green-900/50 text-green-400 border border-green-700' :
                            project.status === 'inactive' ? 'bg-gray-700 text-gray-300 border border-gray-600' :
                            'bg-red-900/50 text-red-400 border border-red-700' %>">
                        <%= project.status.charAt(0).toUpperCase() + project.status.slice(1) %>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Channels Grid -->
    <div class="">
        <% if (channels.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
                <% channels.forEach(function(channel) { 
                    const platformName = channel.platform || channel.channel_platform || 'unknown';
                %>
                    <div class="bg-gray-800 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-200 overflow-hidden border border-gray-700 hover:border-blue-500 group cursor-pointer">
                        <!-- Channel Card -->
                        <div class="p-6">
                            <div class="flex items-start justify-between mb-4">
                                <!-- Platform Icon -->
                                <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br 
                                    <%= platformName === 'youtube' ? 'from-red-500 to-red-600' : 
                                        platformName === 'facebook' ? 'from-blue-500 to-blue-600' :
                                        platformName === 'instagram' ? 'from-pink-500 to-pink-600' :
                                        platformName === 'twitch' ? 'from-purple-500 to-purple-600' :
                                        platformName === 'tiktok' ? 'from-pink-500 to-pink-600' :
                                        'from-gray-500 to-gray-600' %> 
                                    rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="ti 
                                        <%= platformName === 'youtube' ? 'ti-brand-youtube' : 
                                            platformName === 'facebook' ? 'ti-brand-facebook' :
                                            platformName === 'instagram' ? 'ti-brand-instagram' :
                                            platformName === 'twitch' ? 'ti-brand-twitch' :
                                            platformName === 'tiktok' ? 'ti-brand-tiktok' :
                                            'ti-broadcast' %> 
                                        text-white text-3xl"></i>
                                </div>
                                
                                <!-- OAuth Status Badge -->
                                <% if (channel.oauth_connected) { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-400 border border-green-700">
                                        <i class="ti ti-check text-xs mr-1"></i>
                                        OAuth
                                    </span>
                                <% } %>
                            </div>

                            <!-- Channel Name -->
                            <h3 class="text-lg font-semibold text-white mb-2 truncate group-hover:text-blue-400 transition-colors">
                                <%= channel.channel_name %>
                            </h3>

                            <!-- Platform Badge -->
                            <div class="mb-4 flex justify-end hidden">
                                <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full 
                                    <%= platformName === 'youtube' ? 'bg-red-900/50 text-red-400 border border-red-700' : 
                                        platformName === 'instagram' ? 'bg-pink-900/50 text-pink-400 border border-pink-700' :
                                        platformName === 'twitch' ? 'bg-purple-900/50 text-purple-400 border border-purple-700' :
                                        platformName === 'tiktok' ? 'bg-pink-900/50 text-pink-400 border border-pink-700' :
                                        'bg-gray-700 text-gray-300 border border-gray-600' %>">
                                    <i class="ti 
                                        <%= platformName === 'youtube' ? 'ti-brand-youtube' : 
                                            platformName === 'instagram' ? 'ti-brand-instagram' :
                                            platformName === 'twitch' ? 'ti-brand-twitch' :
                                            platformName === 'tiktok' ? 'ti-brand-tiktok' :
                                            'ti-broadcast' %>  
                                        text-xs mr-1.5"></i>
                                    <%= platformName.charAt(0).toUpperCase() + platformName.slice(1) %>
                                </span>
                            </div>

                            <!-- Channel Stats -->
                            <div class="space-y-2 mb-4">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-400 flex items-center">
                                        <i class="ti ti-folder text-purple-400 mr-2"></i>
                                        Galleries
                                    </span>
                                    <span class="font-semibold text-white"><%= channel.gallery_count || 0 %></span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-400 flex items-center">
                                        <i class="ti ti-playlist text-green-400 mr-2"></i>
                                        Playlists
                                    </span>
                                    <span class="font-semibold text-white"><%= channel.playlist_count || 0 %></span>
                                </div>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-400 flex items-center">
                                        <i class="ti ti-broadcast text-blue-400 mr-2"></i>
                                        Broadcasts
                                    </span>
                                    <span class="font-semibold text-white"><%= channel.broadcast_count || 0 %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center border-t border-gray-700 bg-gray-750">
                            <a href="/channels/<%= channel.channel_uuid %>"
                               class="flex-1 inline-flex items-center justify-center px-3 sm:px-4 py-3 text-sm sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
                                <i class="ti ti-eye mr-1.5 sm:mr-1.5"></i>
                                <span class="hidden xs:inline">View</span>
                            </a>
                            <!--
                            <div class="w-px h-8 bg-gray-700"></div>
                            <button onclick="event.preventDefault(); event.stopPropagation(); editChannel('<%= channel.channel_uuid %>')"
                                    class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors">
                                <i class="ti ti-edit mr-1 sm:mr-1.5"></i>
                                <span class="hidden xs:inline">Edit</span>
                            </button>
                            -->
                            <div class="w-px h-8 bg-gray-700"></div>
                            <button onclick="event.preventDefault(); event.stopPropagation(); deleteChannel('<%= channel.channel_uuid %>')"
                                    class="flex-1 inline-flex items-center justify-center px-4 sm:px-4 py-3 text-sm sm:text-sm font-medium text-red-400 hover:bg-gray-700 hover:text-red-300 transition-colors">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="text-center py-16 bg-gray-800 rounded-xl border border-gray-700">
                <div class="flex justify-center mb-4">
                    <div class="w-24 h-24 bg-gray-700 rounded-full flex items-center justify-center">
                        <i class="ti ti-smart-home text-gray-500 text-6xl"></i>
                    </div>
                </div>
                <h3 class="text-xl font-semibold text-white mb-2">No Channels Yet</h3>
                <p class="text-gray-400 mb-6 max-w-md mx-auto">
                    Start by adding your first channel to this project. You can connect to YouTube, Facebook, Twitch, TikTok, and more.
                </p>
                <button onclick="openNewChannelModal()" 
                        class="inline-flex items-center px-4 sm:px-6 py-3 bg-blue-600 border border-transparent rounded-lg text-sm sm:text-base font-medium text-white hover:bg-blue-700 transition-colors shadow-sm">
                    <i class="ti ti-plus mr-2"></i>
                    <span class="hidden xs:inline">Add Your First Channel</span>
                    <span class="xs:hidden">Add Channel</span>
                </button>
            </div>
        <% } %>
    </div>
</div>
    <!-- Modals -->
    <%- include('modals/edit-project') %>
    <%- include('modals/add-channel') %>
    </div>
  </main>
</div>

