<% layout('dashboard/layout') %>

<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %> <%- include('../../partials/sidebar')
  %>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto lg:ml-20 pt-[72px]">
    <div class="p-4 sm:p-6 lg:p-8">
      <!-- Header with Back Button -->
      <div class="mb-8">
        <div
          class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
        >
          <div class="flex items-center gap-5">
            <a
              href="/projects"
              class="w-11 h-11 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all duration-300 shadow-sm"
            >
              <i class="ti ti-arrow-left text-xl"></i>
            </a>
            <div class="min-w-0">
              <div class="flex items-center gap-3 mb-1">
                <h1 class="text-2xl sm:text-3xl font-bold text-white truncate">
                  <%= project.project_name %>
                </h1>
                <div
                  class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50 hidden"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full <%= project.status === 'active' ? 'bg-green-500' : project.status === 'inactive' ? 'bg-gray-500' : 'bg-red-500' %>"
                  ></span>
                  <span
                    class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
                    ><%= project.status %></span
                  >
                </div>
              </div>
              <% if (project.description) { %>
              <p class="text-gray-500 text-sm max-w-2xl line-clamp-1">
                <%= project.description %>
              </p>
              <% } %>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button
              onclick="editProject()"
              class="flex-1 sm:flex-none inline-flex items-center justify-center px-5 py-2.5 border border-gray-700/50 rounded-xl text-sm font-semibold text-gray-300 bg-gray-800/40 hover:bg-gray-800 hover:text-white transition-all duration-300"
            >
              <i class="ti ti-edit mr-2"></i>
              <span>Edit Project</span>
            </button>
            <button
              onclick="openNewChannelModal()"
              class="flex-1 sm:flex-none inline-flex items-center justify-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 rounded-xl text-sm font-semibold text-white transition-all duration-300 shadow-lg shadow-blue-600/20"
            >
              <i class="ti ti-plus mr-2"></i>
              <span>Add Channel</span>
            </button>
          </div>
        </div>

        <!-- Project Overview Stats -->
        <div
          class="flex flex-wrap items-center gap-6 mt-8 pt-6 border-t border-gray-800/50"
        >
          <div
            class="flex items-center gap-2.5 text-sm text-gray-400 font-medium"
          >
            <div class="w-2 h-2 rounded-full bg-blue-500/50"></div>
            <span
              ><i class="ti ti-device-tv"></i> <%= channels.length %> Channel<%=
              channels.length !== 1 ? 's' : '' %></span
            >
          </div>
          <div
            class="flex items-center gap-2.5 text-sm text-gray-400 font-medium"
          >
            <div class="w-2 h-2 rounded-full bg-purple-500/50"></div>
            <span
              ><i class="ti ti-calendar"></i> <%= new
              Date(project.created_at).toLocaleDateString(undefined, { year:
              'numeric', month: 'short', day: 'numeric' }) %></span
            >
          </div>
          <div
            class="flex items-center gap-2.5 text-sm text-gray-400 font-medium"
          >
            <div
              class="w-2 h-2 rounded-full <%= project.status === 'active' ? 'bg-green-500' : 'bg-gray-500' %>"
            ></div>
            <span class="flex items-center gap-2"
              ><i class="ti ti-info-circle opacity-70"></i>
              <span class="uppercase tracking-wider text-[11px] font-bold"
                ><%= project.status %></span
              ></span
            >
          </div>
        </div>
      </div>

      <!-- Channels Grid -->
      <div class="">
        <% if (channels.length > 0) { %>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
        >
          <% channels.forEach(function(channel) { const platformName =
          channel.platform || channel.channel_platform || 'unknown'; %>
          <div
            class="group bg-gray-800/40 hover:bg-gray-800/50 border border-gray-700/50 hover:border-blue-500/50 rounded-2xl transition-all duration-300 flex flex-col h-full shadow-sm hover:shadow-xl hover:shadow-blue-500/5"
          >
            <!-- Channel Card Content -->
            <div class="p-6 flex-grow">
              <div class="flex items-start justify-between mb-5">
                <!-- Platform Icon -->
                <div
                  class="w-14 h-14 rounded-2xl bg-gray-900 border border-gray-700/50 flex items-center justify-center transition-all duration-300 group-hover:border-blue-500/30"
                >
                  <i
                    class="ti <%= platformName === 'youtube' ? 'ti-brand-youtube text-red-500' : platformName === 'facebook' ? 'ti-brand-facebook text-blue-500' : platformName === 'instagram' ? 'ti-brand-instagram text-pink-500' : platformName === 'twitch' ? 'ti-brand-twitch text-purple-500' : platformName === 'tiktok' ? 'ti-brand-tiktok text-white' : 'ti-broadcast text-gray-400' %> text-3xl"
                  ></i>
                </div>

                <!-- OAuth Status Dot -->
                <% if (channel.oauth_connected) { %>
                <div
                  class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                  <span
                    class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
                    >Connected</span
                  >
                </div>
                <% } else { %>
                <div
                  class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
                  <span
                    class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
                    >Manual</span
                  >
                </div>
                <% } %>
              </div>

              <!-- Channel Name -->
              <h3
                class="text-lg font-bold text-white mb-4 truncate group-hover:text-blue-400 transition-colors"
              >
                <%= channel.channel_name %>
              </h3>

              <!-- Channel Stats (Minimalist) -->
              <div
                class="grid grid-cols-3 gap-2 py-4 border-y border-gray-700/30"
              >
                <div class="text-center">
                  <div class="text-xs text-gray-500 mb-1">Galleries</div>
                  <div class="text-sm font-bold text-white">
                    <%= channel.gallery_count || 0 %>
                  </div>
                </div>
                <div class="text-center border-x border-gray-700/30 px-2">
                  <div class="text-xs text-gray-500 mb-1">Playlists</div>
                  <div class="text-sm font-bold text-white">
                    <%= channel.playlist_count || 0 %>
                  </div>
                </div>
                <div class="text-center">
                  <div class="text-xs text-gray-500 mb-1">Live</div>
                  <div class="text-sm font-bold text-white">
                    <%= channel.broadcast_count || 0 %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Actions (Minimalist Footer) -->
            <div class="flex items-center border-t border-gray-700/30 mt-auto">
              <a
                href="/channels/<%= channel.channel_uuid %>"
                class="flex-1 py-4 flex items-center justify-center gap-2 text-[10px] font-bold text-gray-400 hover:text-gray-500 transition-all hover:bg-gray-500/5 transition-all uppercase tracking-widest group/btn"
              >
                <i class="ti ti-eye text-sm"></i>
                <span>View</span>
              </a>
              <div class="w-px h-4 bg-gray-700/50"></div>
              <button
                onclick="event.preventDefault(); event.stopPropagation(); deleteChannel('<%= channel.channel_uuid %>')"
                class="flex-1 py-4 flex items-center justify-center text-red-500/70 hover:text-red-500 transition-all hover:bg-red-500/5"
              >
                <i class="ti ti-trash text-sm"></i>
              </button>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <!-- Empty State -->
        <div
          class="col-span-full bg-gray-900/30 border border-dashed border-gray-800 rounded-3xl p-16 text-center"
        >
          <div
            class="w-20 h-20 bg-gray-800/50 rounded-full flex items-center justify-center mx-auto mb-6 border border-gray-800"
          >
            <i class="ti ti-smart-home text-4xl text-gray-600"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No Channels Yet</h3>
          <p
            class="text-gray-500 mb-8 max-w-sm mx-auto text-sm leading-relaxed"
          >
            This project doesn't have any channels yet. Connect your social
            media channels to start managing your streams.
          </p>
          <button
            onclick="openNewChannelModal()"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-xl transition-all font-semibold shadow-lg shadow-blue-600/20"
          >
            <i class="ti ti-plus"></i>
            <span>Connect Channel</span>
          </button>
        </div>
        <% } %>
      </div>
      <!-- Modals -->
      <%- include('modals/edit-project') %> <%- include('modals/add-channel') %>
    </div>
  </main>
</div>

