<% if (contentList.length > 0) { %>
<!-- Pagination -->
<div class="mt-12 space-y-6">
  <div class="flex items-center justify-center gap-3 flex-wrap">
    <!-- Previous Button -->
    <button
      onclick="goToGalleryPage(Math.max(1, currentGalleryPage - 1))"
      class="w-10 h-10 flex items-center justify-center bg-gray-800/40 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed shadow-sm"
      id="galleryPrevBtn"
    >
      <i class="ti ti-chevron-left text-lg"></i>
    </button>

    <!-- Page Numbers -->
    <div id="galleryPaginationNumbers" class="flex items-center gap-2.5">
      <!-- Page numbers will be generated by JavaScript -->
    </div>

    <!-- Next Button -->
    <button
      onclick="goToGalleryPage(Math.min(totalGalleryPages, currentGalleryPage + 1))"
      class="w-10 h-10 flex items-center justify-center bg-gray-800/40 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed shadow-sm"
      id="galleryNextBtn"
    >
      <i class="ti ti-chevron-right text-lg"></i>
    </button>
  </div>

  <!-- Info Text -->
  <p
    class="text-center text-xs font-bold text-gray-500 uppercase tracking-widest"
    id="galleryShowingInfo"
  >
    <!-- Pagination info will be shown here -->
  </p>
</div>
<% } %>
