<!-- Video Grid -->
<% if (contentList.length === 0) { %>
<div
  class="col-span-full bg-gray-900/30 border border-dashed border-gray-700 rounded-md p-10 text-center"
>
  <div
    class="w-20 h-20 bg-gray-800/50 rounded-full flex items-center justify-center mx-auto mb-6 border border-gray-800"
  >
    <i class="ti ti-video text-4xl text-gray-600"></i>
  </div>
  <h3 class="text-xl font-bold text-white mb-2">No Content Yet</h3>
  <p class="text-gray-500 mb-8 max-w-sm mx-auto text-sm leading-relaxed">
    Your gallery is currently empty. Upload your first video content or import
    from Google Drive to start streaming.
  </p>
  <button
    onclick="openUploadModal()"
    class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-md transition-colors font-semibold"
  >
    <i class="ti ti-upload"></i>
    <span>Upload Content</span>
  </button>
</div>
<% } else { %>
<div
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
  id="videoGrid"
>
  <% contentList.forEach(function(content) { %>
  <div
    class="group bg-gray-800/40 hover:bg-gray-800/70 border border-gray-700/50 hover:border-gray-600 rounded-md transition-colors flex flex-col h-full video-card"
    data-content-id="<%= content.content_id %>"
    data-date="<%= new Date(content.upload_date).getTime() %>"
    data-size="<%= content.filesize || 0 %>"
  >
    <!-- Thumbnail -->
    <div
      class="aspect-video bg-gray-900 relative overflow-hidden rounded-t-md"
    >
      <% if (content.thumbnail_path) { %>
      <img
        src="<%= getThumbnailUrl(content.thumbnail_path) %>"
        alt="<%= content.title %>"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><i class=\'ti ti-video text-4xl text-gray-700\'></i></div>';"
      />
      <% } else { %>
      <div
        class="w-full h-full flex items-center justify-center bg-gray-800/50"
      >
        <i class="ti ti-video text-4xl text-gray-700"></i>
      </div>
      <% } %>

      <!-- Duration Badge -->
      <div
        class="absolute bottom-3 right-3 bg-gray-900/90 backdrop-blur-md px-2 py-1 rounded-lg text-[10px] font-bold text-white border border-white/10 tracking-wider"
      >
        <%= formatDuration(content.duration_seconds) %>
      </div>

      <!-- Hover Play Overlay -->
      <div
        class="absolute inset-0 bg-gray-900/60 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center"
      >
        <button
          onclick="playVideo('<%= content.content_id %>')"
          class="w-12 h-12 bg-blue-600 hover:bg-blue-700 rounded-full flex items-center justify-center transition-all transform scale-90 group-hover:scale-100 shadow-xl shadow-blue-600/40"
          title="Preview"
        >
          <i class="ti ti-player-play text-white text-xl ml-1"></i>
        </button>
      </div>
    </div>

    <!-- Info -->
    <div class="p-4 flex-grow">
      <h3
        class="text-base font-bold text-white mb-3 truncate group-hover:text-blue-400 transition-colors"
        title="<%= content.title %>"
      >
        <%= content.title %>
      </h3>

      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="flex items-center gap-2 text-xs text-gray-500">
          <i class="ti ti-calendar-event text-sm text-gray-600"></i>
          <span
            ><%= new Date(content.upload_date).toLocaleDateString(undefined, {
            month: 'short', day: 'numeric', year: 'numeric' }) %></span
          >
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-500 justify-end">
          <i class="ti ti-device-floppy text-sm text-gray-600"></i>
          <span><%= formatFileSize(content.filesize) %></span>
        </div>
      </div>

      <% if (content.resolution) { %>
      <div
        class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-gray-900/50 border border-gray-700/30 w-fit"
      >
        <i class="ti ti-aspect-ratio text-xs text-blue-500"></i>
        <span
          class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"
          ><%= content.resolution %></span
        >
      </div>
      <% } %>
    </div>

    <!-- Actions Footer -->
    <div class="flex items-center border-t border-gray-700/30 mt-auto">
      <button
        onclick="editVideo('<%= content.content_id %>')"
        class="flex-1 py-4 flex items-center justify-center gap-2 text-[10px] font-bold text-gray-400 hover:text-white transition-all uppercase tracking-widest group/btn"
      >
        <i class="ti ti-edit text-sm"></i>
        <span>Settings</span>
      </button>
      <div class="w-px h-4 bg-gray-700/50"></div>
      <button
        onclick="deleteVideo('<%= content.content_id %>')"
        class="flex-1 py-4 flex items-center justify-center text-red-500/70 hover:text-red-500 transition-all hover:bg-red-500/5"
        title="Delete"
      >
        <i class="ti ti-trash text-sm"></i>
      </button>
    </div>
  </div>
  <% }) %>
</div>
<% } %>
