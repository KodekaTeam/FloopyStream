<!-- Header with Back Button -->
<div class="mb-5 sm:mb-6">
  <div
    class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4"
  >
    <div class="flex items-center gap-3">
      <% if (channelInfo) { %>
      <a
        href="/channels/<%= channelInfo.channel_uuid %>"
        class="w-10 h-10 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-md transition-colors"
      >
        <i class="ti ti-arrow-left text-xl"></i>
      </a>
      <% } %>
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-bold text-white truncate">
          <% if (typeof gallery !== 'undefined' && gallery) { %> <%=
          gallery.gallery_title %> <% } else if (typeof channelInfo !==
          'undefined' && channelInfo) { %> <%= channelInfo.channel_name %> -
          Gallery <% } else { %> Video Gallery <% } %>
        </h1>
        <p class="text-gray-500 text-sm max-w-2xl line-clamp-1 mt-1">
          <% if (typeof gallery !== 'undefined' && gallery) { %> <%=
          gallery.gallery_description || 'Manage videos in this gallery' %> <% }
          else if (typeof channelInfo !== 'undefined' && channelInfo) { %>
          Manage videos for <%= channelInfo.channel_name %> <% } else { %>
          Manage your videos for streaming <% } %>
        </p>
      </div>
    </div>
  </div>

  <!-- Stats Overview -->
  <div
    class="flex flex-wrap items-center gap-4 mt-5 pt-4 border-t border-gray-800/50"
  >
    <div class="flex items-center gap-2.5 text-sm text-gray-400 font-medium">
      <div class="w-2 h-2 rounded-full bg-blue-500/50"></div>
      <span>
        <i class="ti ti-video opacity-70"></i>
        <%= (typeof contentList !== 'undefined' && contentList) ?
        contentList.length : 0 %> Content
      </span>
    </div>
    <% if (typeof gallery !== 'undefined' && gallery && gallery.created_at) { %>
    <div class="flex items-center gap-2.5 text-sm text-gray-400 font-medium">
      <div class="w-2 h-2 rounded-full bg-purple-500/50"></div>
      <span>
        <i class="ti ti-calendar opacity-70"></i>
        Created <%= new Date(gallery.created_at).toLocaleDateString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric' }) %>
      </span>
    </div>
    <% } %>
  </div>
</div>
