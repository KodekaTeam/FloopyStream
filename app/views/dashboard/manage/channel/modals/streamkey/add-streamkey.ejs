<!-- Create Stream Key Modal -->
<div
  id="createStreamKeyModal"
  class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50"
>
  <div
    class="relative top-20 mx-auto p-5 border w-full max-w-md shadow-lg rounded-lg bg-gray-800 border-gray-700"
  >
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-white">Create New Stream Key</h3>
      <button
        onclick="closeCreateStreamKeyModal()"
        class="text-gray-400 hover:text-white transition-colors"
      >
        <i class="ti ti-x text-2xl"></i>
      </button>
    </div>

    <form id="createStreamKeyForm" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2"
          >Stream Key Name</label
        >
        <input
          type="text"
          id="streamKeyName"
          name="name"
          required
          class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
          placeholder="e.g., Main Stream Key"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2"
          >Description (Optional)</label
        >
        <textarea
          id="streamKeyDescription"
          name="description"
          rows="3"
          class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
          placeholder="Description for this stream key"
        ></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2"
          >Streaming Protocol</label
        >
        <select
          id="streamingProtocol"
          name="streamingProtocol"
          class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
        >
          <option value="rtmp">RTMP (Recommended)</option>
          <option value="dash">DASH</option>
          <option value="hls">HLS</option>
        </select>
      </div>

      <div class="space-y-3">
        <div class="flex items-center">
          <input
            type="checkbox"
            id="enableManualSettings"
            name="enableManualSettings"
            class="w-4 h-4 text-red-600 bg-gray-700 border-gray-600 rounded focus:ring-red-500 focus:ring-2"
            onchange="toggleManualSettings()"
          />
          <label
            for="enableManualSettings"
            class="ml-2 text-sm font-medium text-gray-300"
          >
            Turn on manual settings
          </label>
        </div>

        <!-- Manual Settings Options (hidden by default) -->
        <div
          id="manualSettingsOptions"
          class="hidden space-y-3 ml-6 border-l-2 border-gray-600 pl-4"
        >
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-2">
              Resolution
            </label>
            <select
              id="manualResolution"
              name="manualResolution"
              class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
            >
              <option value="1080p">1080p (Full HD)</option>
              <option value="720p">720p (HD)</option>
              <option value="480p">480p (SD)</option>
              <option value="360p">360p (Low)</option>
            </select>
          </div>
        </div>

        <div class="flex items-center">
          <input
            type="checkbox"
            id="enable60fps"
            name="enable60fps"
            class="w-4 h-4 text-red-600 bg-gray-700 border-gray-600 rounded focus:ring-red-500 focus:ring-2"
          />
          <label
            for="enable60fps"
            class="ml-2 text-sm font-medium text-gray-300"
          >
            Enable 60 FPS
          </label>
        </div>
      </div>

      <div class="flex justify-end space-x-3 pt-4">
        <button
          type="button"
          onclick="closeCreateStreamKeyModal()"
          class="px-4 py-2 bg-gray-700 text-gray-300 rounded-lg hover:bg-gray-600 transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
        >
          <i class="ti ti-device-floppy mr-2"></i>
          Create Stream Key
        </button>
      </div>
    </form>
  </div>
</div>
