<% layout('dashboard/layout') %>

<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %>
  <%- include('../../partials/sidebar') %>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto lg:ml-20 pt-[72px]">
    <div class="p-4 sm:p-6 lg:p-8">
    <!-- Header with Back Button -->
    <div class="mb-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div class="flex items-center gap-5">
                <a href="/projects/detail/<%= channel.project_uuid %>" class="w-11 h-11 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all duration-300 shadow-sm">
                    <i class="ti ti-arrow-left text-xl"></i>
                </a>
                <div class="min-w-0">
                    <div class="flex items-center gap-3 mb-1">
                        <!-- Platform Icon (Minimalist) -->
                        <div class="w-10 h-10 rounded-xl bg-gray-900 border border-gray-700/50 flex items-center justify-center flex-shrink-0">
                            <i class="ti
                                <%= channel.channel_platform === 'youtube' ? 'ti-brand-youtube text-red-500' :
                                    channel.channel_platform === 'facebook' ? 'ti-brand-facebook text-blue-500' :
                                    channel.channel_platform === 'instagram' ? 'ti-brand-instagram text-pink-500' :
                                    channel.channel_platform === 'twitch' ? 'ti-brand-twitch text-purple-500' :
                                    channel.channel_platform === 'tiktok' ? 'ti-brand-tiktok text-white' :
                                    'ti-broadcast text-gray-400' %>
                                text-xl"></i>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-bold text-white truncate leading-tight"><%= channel.channel_name %></h1>

                        <% if (channel.is_verified) { %>
                            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Verified</span>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Platform:</span>
                        <span class="text-sm font-semibold text-gray-400 capitalize"><%= channel.channel_platform %></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="editChannel()" class="flex-1 sm:flex-none inline-flex items-center justify-center px-5 py-2.5 border border-gray-700/50 rounded-xl text-sm font-semibold text-gray-300 bg-gray-800/40 hover:bg-gray-800 hover:text-white transition-all duration-300">
                    <i class="ti ti-edit mr-2"></i>
                    <span>Edit Channel</span>
                </button>
            </div>
        </div>

        <!-- Channel Overview Stats -->
        <div class="flex flex-wrap items-center gap-6 mt-8 pt-6 border-t border-gray-800/50">
            <div class="flex items-center gap-2.5 text-sm text-gray-400 font-medium">
                <div class="w-2 h-2 rounded-full bg-blue-500/50"></div>
                <span><%= galleries.length %> Gallery<%= galleries.length !== 1 ? 'ies' : '' %></span>
            </div>
            <div class="flex items-center gap-2.5 text-sm text-gray-400 font-medium">
                <div class="w-2 h-2 rounded-full bg-green-500/50"></div>
                <span><%= playlists.length %> Playlist<%= playlists.length !== 1 ? 's' : '' %></span>
            </div>
            <div class="flex items-center gap-2.5 text-sm text-gray-400 font-medium">
                <div class="w-2 h-2 rounded-full bg-purple-500/50"></div>
                <span>Connected on <%= new Date(channel.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            </div>
            <% if (oauth && oauth.length > 0) { %>
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-900/20 border border-green-800/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    <span class="text-[10px] font-bold text-green-500/80 uppercase tracking-widest">OAuth Active</span>
                </div>
            <% } %>
        </div>
    </div>

    <!--  Youtube Analytics  -->
    <% if (channel.channel_platform === 'youtube' && oauth && oauth.length > 0) { %>
        <div class="mt-8 mb-6" hidden>
            <h2 class="text-lg font-semibold text-white mb-4 flex items-center">
                <i class="ti ti-brand-youtube text-red-500 mr-2"></i>
                YouTube Channel Analytics
            </h2>
            <% if (youtubeData) { %>
                <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4"> -->
                    <!-- Subscribers -->
                    <!-- <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 flex flex-col items-center shadow-lg">
                        <i class="ti ti-user text-4xl text-red-400 mb-3"></i>
                        <span class="text-gray-400 text-sm mb-1">Subscribers</span>
                        <span class="text-3xl font-bold text-white"><%= youtubeData.subscriberCount %></span>
                    </div> -->
                    <!-- Videos -->
                    <!-- <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 flex flex-col items-center shadow-lg">
                        <i class="ti ti-video text-4xl text-red-400 mb-3"></i>
                        <span class="text-gray-400 text-sm mb-1">Total Videos</span>
                        <span class="text-3xl font-bold text-white"><%= youtubeData.videoCount %></span>
                    </div> -->
                    <!-- Views -->
                    <!-- <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 flex flex-col items-center shadow-lg">
                        <i class="ti ti-eye text-4xl text-red-400 mb-3"></i>
                        <span class="text-gray-400 text-sm mb-1">Total Views</span>
                        <span class="text-3xl font-bold text-white"><%= youtubeData.viewCount %></span>
                    </div> -->
                <!-- </div> -->

                <div class="mt-8 bg-gray-900 rounded-xl p-8 border border-gray-800 shadow-lg" hi>
                    <div class="flex items-center space-x-6 mb-6">
                        <img src="<%= youtubeData.thumbnailUrl %>" alt="Channel Thumbnail" class="w-20 h-20 rounded-full border-4 border-red-500 shadow">
                        <div>
                            <a href="https://www.youtube.com/channel/<%= youtubeData.channelId %>" target="_blank" class="text-2xl font-bold text-white hover:text-red-400 transition-colors">
                                <%= youtubeData.title %>
                                <i class="ti ti-external-link ml-2 text-base text-gray-400"></i>
                            </a>
                            <div class="flex items-center mt-2 space-x-4">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-900/50 text-red-400 border border-red-700">
                                    <i class="ti ti-user mr-1"></i> <%= youtubeData.subscriberCount %> Subs
                                </span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">
                                    <i class="ti ti-calendar mr-1"></i> Published <%= new Date(youtubeData.publishedAt).toLocaleDateString() %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
                        <!-- Channel Info -->
                        <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow flex flex-col justify-center">
                            <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
                                <i class="ti ti-info-circle mr-2 text-blue-400"></i>
                                Channel Info
                            </h3>
                            <div class="space-y-3">
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Name:</span>
                                    <span class="text-gray-100"><%= youtubeData.title %></span>
                                </div>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Channel ID:</span>
                                    <span class="text-gray-100"><%= youtubeData.channelId %></span>
                                </div>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Published:</span>
                                    <span class="text-gray-100"><%= new Date(youtubeData.publishedAt).toLocaleDateString() %></span>
                                </div>
                                <% if (youtubeData.country) { %>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Country:</span>
                                    <span class="text-gray-100"><%= youtubeData.country %></span>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <!-- Channel Stats -->
                        <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow flex flex-col justify-center">
                            <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
                                <i class="ti ti-chart-bar mr-2 text-green-400"></i>
                                Channel Stats
                            </h3>
                            <div class="space-y-3">
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Subscribers:</span>
                                    <span class="text-gray-100"><%= youtubeData.subscriberCount %></span>
                                </div>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Total Videos:</span>
                                    <span class="text-gray-100"><%= youtubeData.videoCount %></span>
                                </div>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Total Views:</span>
                                    <span class="text-gray-100"><%= youtubeData.viewCount.toLocaleString('id-ID') %></span>
                                </div>
                                <% if (youtubeData.customUrl) { %>
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-300 w-32">Custom URL:</span>
                                    <a href="https://www.youtube.com/<%= youtubeData.customUrl %>" target="_blank" class="text-blue-400 hover:underline"><%= youtubeData.customUrl %></a>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% if (youtubeData.description) { %>
                        <div class="mt-4">
                            <h4 class="text-base font-semibold text-white mb-2">Description</h4>
                            <p class="text-gray-400 text-sm leading-relaxed"><%= youtubeData.description %></p>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 text-center">
                    <div class="flex justify-center mb-4">
                        <i class="ti ti-brand-youtube text-red-400 text-5xl"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-white mb-2">No YouTube Data Available</h3>
                    <p class="text-gray-400 mb-2">Unable to fetch channel analytics. Please check your OAuth connection.</p>
                    <button onclick="refreshYouTubeData()" class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors">
                        <i class="ti ti-refresh mr-2"></i>
                        Refresh Data
                    </button>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- Tabs -->
    <div class="w-full mt-10">
        <div class="border-b border-gray-800/50">
            <nav class="-mb-px flex space-x-8 overflow-x-auto scrollbar-hide" style="scroll-behavior: smooth;">
                <% if (channel.channel_platform == 'youtube') { %>
                <button onclick="switchTab('channel')"
                        id="tab-channel"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-chart-bar text-base"></i>
                    <span>Channel</span>
                </button>
                <% } %>
                <button onclick="switchTab('galleries')"
                        id="tab-galleries"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-folder text-base"></i>
                    <span>Galleries</span>
                </button>
                <button onclick="switchTab('playlists')"
                        id="tab-playlists"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-playlist text-base"></i>
                    <span>Playlists</span>
                </button>
                <% if (channel.channel_platform == 'youtube') { %>
                <button onclick="switchTab('streamkeys')"
                        id="tab-streamkeys"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-key text-base"></i>
                    <span>Stream Keys</span>
                </button>
                <button onclick="switchTab('upload-templates')"
                        id="tab-upload-templates"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-template text-base"></i>
                    <span>Templates</span>
                </button>
                <button onclick="switchTab('oauth')"
                        id="tab-oauth"
                        class="tab-button whitespace-nowrap py-4 px-1 border-b-2 border-transparent font-bold text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-2 text-gray-500 hover:text-gray-400">
                    <i class="ti ti-plug text-base"></i>
                    <span>OAuth</span>
                </button>
                <% } %>
            </nav>
        </div>
    </div>

        <!-- Tab Content -->
        <div class="mt-6">
            <!-- Channel Tab -->
            <div id="content-channel" class="tab-content">
                <!--  Youtube Analytics  -->
                <%- include('partials/tabs/channel-tab') %>
            </div>

            <!-- Galleries Tab -->
            <div id="content-galleries" class="tab-content">
                <!-- Galleries Content -->
                <%- include('partials/tabs/galleries-tabs') %>
            </div>

            <!-- Playlists Tab -->
            <div id="content-playlists" class="tab-content hidden">
                <!-- Playlists Content -->
                <%- include('partials/tabs/playlists-tabs') %>
            </div>

            <!-- Stream Keys Tab -->
            <div id="content-streamkeys" class="tab-content hidden">
                <!-- Stream Keys Content -->
                <%- include('./partials/tabs/streamkeys-tabs') %>
            </div>

            <!-- Upload Templates Tab -->
            <div id="content-upload-templates" class="tab-content hidden">
                <!-- Upload Templates Content -->
                <%- include('partials/tabs/upload-templates-tabs') %>
            </div>

            <!-- OAuth Tab -->
            <div id="content-oauth" class="tab-content hidden">
                <!-- OAuth Content -->
                <%- include('partials/tabs/oauth-tabs') %>
            </div>
        </div>
    </div>
</div>

<script>
// Tab Switching
function switchTab(tabName) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
    });

    // Remove active state from all tabs
    document.querySelectorAll('.tab-button').forEach(button => {
        button.classList.remove('border-blue-500', 'text-blue-400');
        button.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-400');
    });

    // Show selected tab content
    const content = document.getElementById('content-' + tabName);
    if (content) content.classList.remove('hidden');

    // Add active state to selected tab
    const activeTab = document.getElementById('tab-' + tabName);
    if (activeTab) {
        activeTab.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-400');
        activeTab.classList.add('border-blue-500', 'text-blue-400');
    }

    // Auto-scroll active tab into view on mobile
    if (window.innerWidth < 768 && activeTab) {
        activeTab.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
        });
    }
}

// Initialize tabs on page load
document.addEventListener('DOMContentLoaded', function() {
    // Set default active tab (channel)
    // switchTab('channel');
    const platform = '<%= channel.channel_platform %>';

    // Use setTimeout to ensure all elements are fully rendered
    setTimeout(() => {
        if (platform === 'youtube') {
            const channelTab = document.getElementById('tab-channel');
            if (channelTab) {
                switchTab('channel');
            } else {
                switchTab('galleries');
            }
        } else {
            switchTab('galleries');
        }
    }, 100);

    // Add touch/swipe support for mobile tabs
    const tabNav = document.querySelector('nav');
    if (tabNav) {
        let startX;
        let scrollLeft;

        tabNav.addEventListener('touchstart', (e) => {
            startX = e.touches[0].pageX - tabNav.offsetLeft;
            scrollLeft = tabNav.scrollLeft;
        });

        tabNav.addEventListener('touchmove', (e) => {
            if (!startX) return;
            const x = e.touches[0].pageX - tabNav.offsetLeft;
            const walk = (x - startX) * 2; // Scroll speed multiplier
            tabNav.scrollLeft = scrollLeft - walk;
        });

        tabNav.addEventListener('touchend', () => {
            startX = null;
        });
    }
});

// All functions moved to /js/channel-detail.js
</script>

<!-- Channel Detail Functions -->
<script src="/js/channel-detail.js"></script>

    </div>
  </main>
</div>

