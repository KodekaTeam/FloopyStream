<!-- Playlists Management -->
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-playlist text-green-500 mr-3"></i>
        Playlists
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Create and manage playlists to organize your videos for streaming
      </p>
    </div>
    <button
      onclick="openNewPlaylistModal()"
      class="inline-flex items-center px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-green-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Playlist
    </button>
  </div>

  <!-- Playlists Grid -->
  <% if (playlists.length > 0) { %>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
  >
    <% playlists.forEach(function(playlist) { %>
    <!-- Playlist Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl transition-all duration-300 overflow-hidden"
    >
      <div class="p-6">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <div
                class="w-10 h-10 bg-green-500/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300"
              >
                <i class="ti ti-playlist text-green-500 text-xl"></i>
              </div>
              <h3
                class="text-lg font-bold text-white truncate group-hover:text-green-400 transition-colors"
              >
                <%= playlist.playlist_name %>
              </h3>
            </div>
            <% if (playlist.description) { %>
            <p class="text-gray-400 text-sm mb-4 line-clamp-2 leading-relaxed">
              <%= playlist.description %>
            </p>
            <% } %>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div
              class="flex items-center gap-2 text-xs font-bold text-gray-400 uppercase tracking-widest"
            >
              <i class="ti ti-video text-green-500/70"></i>
              <span><%= playlist.video_count || 0 %> Videos</span>
            </div>
            <div
              class="flex items-center gap-2 text-xs font-bold text-gray-500 uppercase tracking-widest"
            >
              <i class="ti ti-calendar text-blue-500/70"></i>
              <span
                ><%= new Date(playlist.created_at).toLocaleDateString(undefined,
                { year: 'numeric', month: 'short', day: 'numeric' }) %></span
              >
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center border-t border-gray-700/50 bg-gray-900/30">
        <a
          href="/playlists/<%= playlist.playlist_uuid %>"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-gray-400 hover:bg-gray-700/50 hover:text-white transition-all"
        >
          <i class="ti ti-eye mr-2"></i>
          VIEW
        </a>
        <div class="w-px h-6 bg-gray-700/50"></div>
        <button
          onclick="editPlaylist('<%= playlist.playlist_uuid %>')"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-gray-400 hover:bg-gray-700/50 hover:text-white transition-all"
        >
          <i class="ti ti-edit mr-2"></i>
          EDIT
        </button>
        <div class="w-px h-6 bg-gray-700/50"></div>
        <button
          onclick="deletePlaylist('<%= playlist.playlist_uuid %>')"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all"
        >
          <i class="ti ti-trash"></i>
        </button>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Empty State -->
  <% if (playlists.length === 0) { %>
  <div
    class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
  >
    <div
      class="w-20 h-20 rounded-2xl bg-green-500/10 flex items-center justify-center mx-auto mb-6"
    >
      <i class="ti ti-playlist text-green-500 text-4xl"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">No Playlists Yet</h3>
    <p class="text-gray-400 mb-8 max-w-sm mx-auto">
      Create your first playlist to organize your videos for streaming.
    </p>
    <button
      onclick="openNewPlaylistModal()"
      class="inline-flex items-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-green-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Playlist
    </button>
  </div>
  <% } %>
</div>
