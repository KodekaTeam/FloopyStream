<!-- Playlists Management -->
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-playlist text-green-500 mr-3"></i>
        Playlists
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Create and manage playlists to organize your videos for streaming
      </p>
    </div>
    <button
      onclick="openNewPlaylistModal()"
      class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Playlist
    </button>
  </div>

  <!-- Playlists Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% if (playlists.length > 0) { %> <% playlists.forEach(function(playlist) {
    %>
    <!-- Playlist Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl border border-gray-700 shadow-lg hover:shadow-xl transition-shadow overflow-hidden"
    >
      <div class="p-6">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <div
                class="w-10 h-10 bg-green-500/20 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <i class="ti ti-playlist text-green-400 text-lg"></i>
              </div>
              <h3 class="text-lg font-semibold text-white truncate">
                <%= playlist.playlist_name %>
              </h3>
            </div>
            <% if (playlist.description) { %>
            <p class="text-gray-400 text-sm mb-3 line-clamp-2">
              <%= playlist.description %>
            </p>
            <% } %>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-400 flex items-center">
              <i class="ti ti-video mr-2"></i>
              <%= playlist.video_count || 0 %> videos
            </span>
            <span class="text-gray-400 flex items-center">
              <i class="ti ti-calendar mr-2"></i>
              <%= new Date(playlist.created_at).toLocaleDateString() %>
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center border-t border-gray-700 bg-gray-750">
        <a
          href="/playlists/<%= playlist.playlist_uuid %>"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors"
        >
          <i class="ti ti-eye mr-1 sm:mr-1.5"></i>
          <span class="hidden xs:inline">View</span>
        </a>
        <div class="w-px h-8 bg-gray-700"></div>
        <button
          onclick="editPlaylist('<%= playlist.playlist_uuid %>')"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors"
        >
          <i class="ti ti-edit mr-1 sm:mr-1.5"></i>
          <span class="hidden xs:inline">Edit</span>
        </button>
        <div class="w-px h-8 bg-gray-700"></div>
        <button
          onclick="deletePlaylist('<%= playlist.playlist_uuid %>')"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-red-400 hover:bg-gray-700 hover:text-red-300 transition-colors"
        >
          <i class="ti ti-trash"></i>
        </button>
      </div>
    </div>
    <% }); %> <% } %>
  </div>

  <!-- Empty State -->
  <% if (playlists.length === 0) { %>
  <div class="text-center py-12">
    <div class="flex justify-center mb-4">
      <i class="ti ti-playlist text-gray-600 text-5xl"></i>
    </div>
    <h3 class="text-lg font-semibold text-white mb-2">No Playlists Yet</h3>
    <p class="text-gray-400 mb-6">
      Create playlists to organize your videos for streaming
    </p>
    <button
      onclick="openNewPlaylistModal()"
      class="inline-flex items-center px-6 py-3 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Your First Playlist
    </button>
  </div>
  <% } %>
</div>
