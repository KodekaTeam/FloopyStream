<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div
  class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
>
  <div
    class="w-20 h-20 rounded-2xl bg-yellow-500/10 flex items-center justify-center mx-auto mb-6"
  >
    <i class="ti ti-alert-circle text-yellow-500 text-4xl"></i>
  </div>
  <h3 class="text-xl font-bold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-0 max-w-sm mx-auto">
    Fitur OAuth ini hanya untuk YouTube. Platform yang Anda gunakan saat ini
    tidak mendukung koneksi OAuth.
  </p>
</div>
<% } else { %>
<!-- OAuth Connections Management -->
<div class="space-y-6">
  <!-- Header with Connect Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-plug text-blue-500 mr-3"></i>
        OAuth Connections
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Connect your streaming accounts to sync videos and manage content
      </p>
    </div>
  </div>

  <!-- OAuth Connections Grid -->
  <% if (oauth && oauth.length > 0) { %>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
  >
    <% oauth.forEach(function(connection) { %>
    <!-- OAuth Connection Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl p-6 transition-all duration-300"
    >
      <div class="flex items-start justify-between mb-6">
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300"
          >
            <i class="ti ti-plug text-blue-500 text-2xl"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">
              <%= connection.provider_name %>
            </h3>
            <div class="flex items-center mt-1">
              <% if (connection.access_token) { %>
              <div
                class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-green-900/20 border border-green-800/30"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                <span
                  class="text-[10px] font-bold text-green-500 uppercase tracking-widest"
                  >Connected</span
                >
              </div>
              <% } else { %>
              <div
                class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-red-900/20 border border-red-800/30"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                <span
                  class="text-[10px] font-bold text-red-500 uppercase tracking-widest"
                  >Disconnected</span
                >
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <div class="space-y-3">
          <% if (connection.external_id) { %>
          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >External ID</span
            >
            <span class="text-[11px] font-semibold text-gray-300 font-mono"
              ><%= connection.external_id %></span
            >
          </div>
          <% } %> <% if (connection.token_expires_at) { %>
          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >Expires</span
            >
            <span class="text-[11px] font-semibold text-gray-300"
              ><%= new
              Date(connection.token_expires_at).toLocaleDateString(undefined, {
              year: 'numeric', month: 'short', day: 'numeric' }) %></span
            >
          </div>
          <% } %>
          <div class="flex items-center justify-between">
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >Last Sync</span
            >
            <span class="text-[11px] font-semibold text-gray-300"
              ><%= new Date(connection.updated_at).toLocaleDateString(undefined,
              { year: 'numeric', month: 'short', day: 'numeric' }) %></span
            >
          </div>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t border-gray-700/50">
          <button
            onclick="refreshOAuth('<%= connection.oauth_uuid %>')"
            class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-gray-700/50 hover:bg-gray-700 text-gray-300 hover:text-white rounded-lg text-xs font-bold transition-all"
          >
            <i class="ti ti-refresh mr-2"></i>
            REFRESH
          </button>
          <button
            onclick="disconnectOAuth('<%= connection.oauth_uuid %>')"
            class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white rounded-lg text-xs font-bold transition-all border border-red-500/20"
          >
            <i class="ti ti-unlink mr-2"></i>
            REVOKE
          </button>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Empty State -->
  <% if (!oauth || oauth.length === 0) { %>
  <div
    class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
  >
    <div
      class="w-20 h-20 rounded-2xl bg-blue-500/10 flex items-center justify-center mx-auto mb-6"
    >
      <i class="ti ti-plug text-blue-500 text-4xl"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">No OAuth Connected</h3>
    <p class="text-gray-400 mb-8 max-w-sm mx-auto">
      Connect your accounts to start managing and syncing your content across
      platforms.
    </p>
    <button
      onclick="connectOAuth()"
      class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-blue-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Connect Your First Account
    </button>
  </div>
  <% } %>
</div>
<% } %>
