<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div class="text-center py-12">
  <div class="flex justify-center mb-4">
    <i class="ti ti-alert-circle text-yellow-400 text-5xl"></i>
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-6">
    Fitur OAuth ini hanya untuk YouTube. Platform yang Anda gunakan saat ini
    tidak mendukung koneksi OAuth.
  </p>
</div>
<% } else { %>
<!-- OAuth Connections Management -->
<div class="space-y-6">
  <!-- Header with Connect Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-plug text-blue-500 mr-3"></i>
        OAuth Connections
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Connect your streaming accounts to sync videos and manage content
      </p>
    </div>
  </div>

  <!-- OAuth Connections Grid -->
  <% if (oauth && oauth.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% oauth.forEach(function(connection) { %>
    <!-- OAuth Connection Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg hover:shadow-xl transition-shadow"
    >
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div
            class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center flex-shrink-0"
          >
            <i class="ti ti-plug text-white text-xl"></i>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-white">
              <%= connection.provider_name %>
            </h3>
            <div class="flex items-center mt-1">
              <% if (connection.access_token) { %>
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-600/20 text-green-400 border border-green-600/30"
              >
                <i class="ti ti-circle-filled text-green-400 mr-1 text-xs"></i>
                Connected
              </span>
              <% } else { %>
              <span
                class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-600/20 text-red-400 border border-red-600/30"
              >
                <i class="ti ti-circle-filled text-red-400 mr-1 text-xs"></i>
                Disconnected
              </span>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <div class="text-sm text-gray-400 space-y-1">
          <% if (connection.external_id) { %>
          <p>
            <span class="text-gray-300">ID:</span> <%= connection.external_id %>
          </p>
          <% } %> <% if (connection.token_expires_at) { %>
          <p>
            <span class="text-gray-300">Expires:</span> <%= new
            Date(connection.token_expires_at).toLocaleDateString() %>
          </p>
          <% } %>
          <p>
            <span class="text-gray-300">Updated:</span> <%= new
            Date(connection.updated_at).toLocaleDateString() %>
          </p>
        </div>

        <div
          class="flex items-center justify-between pt-2 border-t border-gray-700"
        >
          <button
            onclick="refreshOAuth('<%= connection.oauth_uuid %>')"
            class="inline-flex items-center px-3 py-1.5 bg-gray-700 text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-600 hover:text-white transition-colors"
          >
            <i class="ti ti-refresh mr-2"></i>
            Refresh
          </button>
          <button
            onclick="disconnectOAuth('<%= connection.oauth_uuid %>')"
            class="inline-flex items-center px-3 py-1.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors"
          >
            <i class="ti ti-unlink mr-2"></i>
            Disconnect
          </button>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Empty State -->
  <% if (!oauth || oauth.length === 0) { %>
  <div class="text-center py-12">
    <div class="flex justify-center mb-4">
      <i class="ti ti-plug text-gray-600 text-5xl"></i>
    </div>
    <h3 class="text-lg font-semibold text-white mb-2">No OAuth Connections</h3>
    <p class="text-gray-400 mb-6 max-w-md mx-auto">
      Connect your streaming accounts to automatically sync videos and access
      advanced features
    </p>
    <button
      onclick="connectOAuth()"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Connect Your First Account
    </button>
  </div>
  <% } %>
</div>
<% } %>
