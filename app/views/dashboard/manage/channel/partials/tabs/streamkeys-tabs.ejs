<!-- Stream Keys Management -->
<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div
  class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
>
  <div
    class="w-20 h-20 rounded-2xl bg-yellow-500/10 flex items-center justify-center mx-auto mb-6"
  >
    <i class="ti ti-alert-circle text-yellow-500 text-4xl"></i>
  </div>
  <h3 class="text-xl font-bold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-0 max-w-sm mx-auto">
    Fitur ini hanya untuk YouTube. Platform yang Anda gunakan saat ini tidak
    mendukung pengelolaan stream key.
  </p>
</div>
<% } else { %>
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-key text-red-500 mr-3"></i>
        Stream Keys
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Manage your streaming keys for live broadcasting
      </p>
    </div>

    <!-- Dropdown Menu -->
    <div class="relative w-full sm:w-auto">
      <button
        id="streamKeyDropdownBtn"
        onclick="toggleStreamKeyDropdown()"
        class="w-full sm:w-auto inline-flex items-center justify-between px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-red-600/20"
      >
        <div class="flex items-center">
          <i class="ti ti-plus mr-2"></i>
          <span>ADD STREAM KEY</span>
        </div>
        <i class="ti ti-chevron-down text-xs ml-3"></i>
      </button>

      <!-- Dropdown Content -->
      <div
        id="streamKeyDropdown"
        class="absolute right-0 mt-3 w-full sm:w-64 bg-[#1a1c22] border border-gray-700/50 rounded-2xl shadow-2xl z-50 hidden overflow-hidden backdrop-blur-xl"
      >
        <div class="p-2 space-y-1">
          <button
            onclick="createNewStreamKey()"
            class="w-full text-left px-4 py-3 text-sm font-bold text-gray-300 hover:bg-red-600 hover:text-white rounded-xl transition-all flex items-center group"
          >
            <div
              class="w-8 h-8 rounded-lg bg-red-500/20 flex items-center justify-center mr-3 group-hover:bg-red-500/20"
            >
              <i class="ti ti-plus text-red-500 group-hover:text-white"></i>
            </div>
            Create New Stream Key
          </button>
          <button
            onclick="syncFromYouTubeStudio()"
            class="w-full text-left px-4 py-3 text-sm font-bold text-gray-300 hover:bg-blue-600 hover:text-white rounded-xl transition-all flex items-center group"
          >
            <div
              class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center mr-3 group-hover:bg-blue-500/20"
            >
              <i class="ti ti-refresh text-blue-500 group-hover:text-white"></i>
            </div>
            Sync from YouTube Studio
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Stream Keys Grid -->
  <div
    id="stream-keys-container"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    <!-- Stream keys will be loaded here -->
  </div>

  <!-- Empty State -->
  <div
    id="empty-state-streamkeys"
    class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
  >
    <div
      class="w-20 h-20 rounded-2xl bg-gray-700/30 flex items-center justify-center mx-auto mb-6"
    >
      <i class="ti ti-key-off text-gray-500 text-4xl"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">No Stream Keys</h3>
    <p class="text-gray-400 mb-8 max-w-sm mx-auto">
      You haven't added any stream keys yet. Create your first stream key to
      start broadcasting.
    </p>
    <button
      onclick="createNewStreamKey()"
      class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-red-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Your First Stream Key
    </button>
  </div>
</div>
<% } %> <%- include('../../modals/streamkey/add-streamkey') %><%-
include('../../modals/streamkey/edit-streamkey') %>
