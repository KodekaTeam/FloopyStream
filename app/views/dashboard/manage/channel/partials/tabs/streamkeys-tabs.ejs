<!-- Stream Keys Management -->
<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div class="text-center py-12">
  <div class="flex justify-center mb-4">
    <i class="ti ti-alert-circle text-yellow-400 text-5xl"></i>
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-6">
    Fitur upload template ini hanya untuk YouTube. Platform yang Anda gunakan
    saat ini tidak mendukung template upload.
  </p>
</div>
<% } else { %>
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-key mr-2 text-red-400"></i>
        Stream Keys
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Manage your streaming keys for live broadcasting
      </p>
    </div>
    <!-- Dropdown Menu -->
    <div class="relative w-full sm:w-auto">
      <button
        id="streamKeyDropdownBtn"
        onclick="toggleStreamKeyDropdown()"
        class="w-full sm:w-auto inline-flex items-center justify-between px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors shadow"
      >
        <div class="flex items-center">
          <span class="hidden sm:inline mr-2"
            ><i class="ti ti-plus text-sm"></i> Add Stream Key</span
          >
          <span class="sm:hidden mr-2"
            ><i class="ti ti-plus text-sm"></i> Add Stream Key</span
          >
        </div>
        <i class="ti ti-chevron-down text-xs ml-2"></i>
      </button>

      <!-- Dropdown Menu -->
      <div
        id="streamKeyDropdown"
        class="absolute right-0 mt-2 w-full sm:w-56 bg-gray-800 border border-gray-700 rounded-lg shadow-lg z-10 hidden"
      >
        <div class="py-1">
          <button
            onclick="createNewStreamKey()"
            class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition-colors flex items-center"
          >
            <i class="ti ti-plus mr-3 text-red-400"></i>
            <span class="hidden sm:inline">Create New Stream Key</span>
            <span class="sm:hidden">Create New</span>
          </button>
          <button
            onclick="syncFromYouTubeStudio()"
            class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 hover:text-white transition-colors flex items-center"
          >
            <i class="ti ti-refresh mr-3 text-blue-400"></i>
            <span class="hidden sm:inline">Sync from YouTube Studio</span>
            <span class="sm:hidden">Sync from YT</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Stream Keys Grid -->
  <div
    id="stream-keys-container"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    <!-- Stream keys will be loaded here -->
  </div>

  <!-- Empty State -->
  <div id="empty-state-streamkeys" class="text-center py-12">
    <div class="flex justify-center mb-4">
      <i class="ti ti-key-off text-gray-600 text-5xl"></i>
    </div>
    <h3 class="text-lg font-semibold text-white mb-2">No Stream Keys</h3>
    <p class="text-gray-400 mb-6">
      Create your first stream key to start broadcasting
    </p>
    <button
      onclick="createNewStreamKey()"
      class="inline-flex items-center px-6 py-3 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Your First Stream Key
    </button>
  </div>
</div>
<% } %> <%- include('../../modals/streamkey/add-streamkey') %><%-
include('../../modals/streamkey/edit-streamkey') %>
