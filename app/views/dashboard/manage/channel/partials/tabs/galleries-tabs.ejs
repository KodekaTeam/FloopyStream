<!-- Galleries Management -->
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-folder text-purple-500 mr-3"></i>
        Galleries
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Organize your videos into galleries for better content management
      </p>
    </div>
    <button
      onclick="openNewGalleryModal()"
      class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Gallery
    </button>
  </div>

  <!-- Galleries Grid -->
  <% if (galleries.length > 0) { %>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
  >
    <% galleries.forEach(function(gallery) { %>
    <!-- Gallery Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl border border-gray-700 shadow-lg hover:shadow-xl transition-shadow group overflow-hidden"
    >
      <div class="p-6">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <div
                class="w-10 h-10 bg-gradient-to-br from-purple-500 to-blue-500 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
              >
                <i class="ti ti-folder text-white text-lg"></i>
              </div>
              <h3
                class="text-lg font-semibold text-white truncate group-hover:text-purple-400 transition-colors"
              >
                <%= gallery.gallery_title %>
              </h3>
            </div>
            <% if (gallery.description) { %>
            <p class="text-gray-400 text-sm mb-3 line-clamp-2">
              <%= gallery.description %>
            </p>
            <% } %>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-400 flex items-center">
              <i class="ti ti-video mr-2"></i>
              <%= gallery.video_count || 0 %> videos
            </span>
            <span
              class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= gallery.status === 'active' ? 'bg-green-600/20 text-green-400 border border-green-600/30' : 'bg-gray-600/20 text-gray-400 border border-gray-600/30' %>"
            >
              <%= gallery.status === 'active' ? 'Active' : 'Inactive' %>
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center border-t border-gray-700 bg-gray-750">
        <a
          href="/gallery/<%= gallery.gallery_uuid %>"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors"
        >
          <i class="ti ti-eye mr-1 sm:mr-1.5"></i>
          <span class="hidden xs:inline">View</span>
        </a>
        <div class="w-px h-8 bg-gray-700"></div>
        <button
          onclick="editGallery('<%= gallery.gallery_uuid %>')"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white transition-colors"
        >
          <i class="ti ti-edit mr-1 sm:mr-1.5"></i>
          <span class="hidden xs:inline">Edit</span>
        </button>
        <div class="w-px h-8 bg-gray-700"></div>
        <button
          onclick="deleteGallery('<%= gallery.gallery_uuid %>')"
          class="flex-1 inline-flex items-center justify-center px-2 sm:px-4 py-3 text-xs sm:text-sm font-medium text-red-400 hover:bg-gray-700 hover:text-red-300 transition-colors"
        >
          <i class="ti ti-trash"></i>
        </button>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Empty State -->
  <% if (galleries.length === 0) { %>
  <div class="text-center py-12">
    <div class="flex justify-center mb-4">
      <i class="ti ti-folder text-gray-600 text-5xl"></i>
    </div>
    <h3 class="text-lg font-semibold text-white mb-2">No Galleries Yet</h3>
    <p class="text-gray-400 mb-6">
      Create galleries to organize your video content for better management
    </p>
    <button
      onclick="openNewGalleryModal()"
      class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-700 transition-colors shadow"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Your First Gallery
    </button>
  </div>
  <% } %>
</div>
