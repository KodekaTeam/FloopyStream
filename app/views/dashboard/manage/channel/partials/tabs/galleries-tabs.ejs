<!-- Galleries Management -->
<div class="space-y-6">
  <!-- Header with Create Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-folder text-purple-500 mr-3"></i>
        Galleries
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        Organize your videos into galleries for better content management
      </p>
    </div>
    <button
      onclick="openNewGalleryModal()"
      class="inline-flex items-center px-5 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-purple-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Gallery
    </button>
  </div>

  <!-- Galleries Grid -->
  <% if (galleries.length > 0) { %>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
  >
    <% galleries.forEach(function(gallery) { %>
    <!-- Gallery Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl transition-all duration-300 overflow-hidden"
    >
      <div class="p-6">
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-3">
              <div
                class="w-10 h-10 bg-purple-500/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300"
              >
                <i class="ti ti-folder text-purple-500 text-xl"></i>
              </div>
              <h3
                class="text-lg font-bold text-white truncate group-hover:text-purple-400 transition-colors"
              >
                <%= gallery.gallery_title %>
              </h3>
            </div>
            <% if (gallery.description) { %>
            <p class="text-gray-400 text-sm mb-4 line-clamp-2 leading-relaxed">
              <%= gallery.description %>
            </p>
            <% } %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div
            class="flex items-center gap-2 text-xs font-bold text-gray-500 uppercase tracking-widest"
          >
            <i class="ti ti-video text-purple-500/70"></i>
            <span><%= gallery.video_count || 0 %> Videos</span>
          </div>
          <% if (gallery.status === 'active') { %>
          <div
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-900/20 border border-green-800/30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            <span
              class="text-[10px] font-bold text-green-500 uppercase tracking-widest"
              >Active</span
            >
          </div>
          <% } else { %>
          <div
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-900/60 border border-gray-700/50"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >Inactive</span
            >
          </div>
          <% } %>
        </div>
      </div>

      <div class="flex items-center border-t border-gray-700/50 bg-gray-900/30">
        <a
          href="/gallery/<%= gallery.gallery_uuid %>"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-gray-400 hover:bg-gray-700/50 hover:text-white transition-all"
        >
          <i class="ti ti-eye mr-2"></i>
          VIEW
        </a>
        <div class="w-px h-6 bg-gray-700/50"></div>
        <button
          onclick="editGallery('<%= gallery.gallery_uuid %>')"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-gray-400 hover:bg-gray-700/50 hover:text-white transition-all"
        >
          <i class="ti ti-edit mr-2"></i>
          EDIT
        </button>
        <div class="w-px h-6 bg-gray-700/50"></div>
        <button
          onclick="deleteGallery('<%= gallery.gallery_uuid %>')"
          class="flex-1 inline-flex items-center justify-center py-3.5 text-xs font-bold text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all"
        >
          <i class="ti ti-trash"></i>
        </button>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <!-- Empty State -->
  <% if (galleries.length === 0) { %>
  <div
    class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
  >
    <div
      class="w-20 h-20 rounded-2xl bg-purple-500/10 flex items-center justify-center mx-auto mb-6"
    >
      <i class="ti ti-folder text-purple-500 text-4xl"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">No Galleries Yet</h3>
    <p class="text-gray-400 mb-8 max-w-sm mx-auto">
      Create your first gallery to start organizing your video content.
    </p>
    <button
      onclick="openNewGalleryModal()"
      class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-purple-600/20"
    >
      <i class="ti ti-plus mr-2"></i>
      Create Gallery
    </button>
  </div>
  <% } %>
</div>
