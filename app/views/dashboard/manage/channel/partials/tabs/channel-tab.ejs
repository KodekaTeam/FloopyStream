<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div class="text-center py-12">
  <div class="flex justify-center mb-4">
    <i class="ti ti-alert-circle text-yellow-400 text-5xl"></i>
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-6">
    Fitur ini hanya untuk YouTube. Platform yang Anda gunakan saat ini tidak
    mendukung fitur analitik channel.
  </p>
</div>
<% } else if (channel.channel_platform === 'youtube' && oauth && oauth.length >
0) { %>
<!-- Channel Analytics Section -->
<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-brand-youtube text-red-500 mr-3"></i>
        Channel Analytics
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        YouTube channel performance and statistics
      </p>
    </div>
    <button
      onclick="refreshYouTubeData()"
      class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors shadow"
    >
      <i class="ti ti-refresh mr-2"></i>
      Refresh Data
    </button>
  </div>

  <% if (youtubeData) { %>
  <!-- Channel Header Card -->
  <div
    class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-4 sm:p-6 border border-gray-700 shadow-lg"
  >
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
      <img
        src="<%= youtubeData.thumbnailUrl %>"
        alt="Channel Thumbnail"
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-4 border-red-500 shadow-lg mx-auto sm:mx-0"
      />
      <div class="flex-1 min-w-0 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-4">
          <span
            class="text-xl sm:text-2xl font-bold text-white flex items-center justify-center sm:justify-start gap-2"
          >
            <a
              href="https://www.youtube.com/channel/<%= youtubeData.channelId %>"
              target="_blank"
              class="hover:text-red-400 transition-colors truncate"
            >
              <%= youtubeData.title %>
              <i
                class="ti ti-external-link text-sm sm:text-base text-gray-400"
              ></i>
            </a>
          </span>
          <% if (youtubeData.isVerified) { %>
          <span
            class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-900/50 text-blue-300 border border-blue-700 whitespace-nowrap"
            title="Verified Channel"
          >
            <i class="ti ti-badge-check-filled mr-1"></i>Verified
          </span>
          <% } %>
        </div>
        <div
          class="flex flex-wrap justify-center sm:justify-start items-center gap-2 sm:gap-4"
        >
          <span
            class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-red-900/50 text-red-300 border border-red-700"
          >
            <i class="ti ti-user mr-1 sm:mr-2 hidden sm:inline"></i>
            <%= youtubeData.subscriberCount %> Subs
          </span>
          <span
            class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-gray-800 text-gray-300 border border-gray-700 hidden"
          >
            <i class="ti ti-calendar mr-1 sm:mr-2"></i>
            <%= new Date(youtubeData.publishedAt).toLocaleDateString() %>
          </span>
          <span
            class="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium <%= youtubeData.monetizationStatus === 'MONETIZATION_STATUS_ENABLED' ? 'bg-green-900/50 text-green-300 border border-green-700' : 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' %>"
            title="<%= youtubeData.monetizationStatus %>"
          >
            <i class="ti ti-coin mr-1 sm:mr-2"></i>
            <%= youtubeData.monetizationStatus === 'MONETIZATION_STATUS_ENABLED'
            ? 'Monetized' : 'Not Monetized' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Subscribers Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg hover:shadow-xl transition-shadow"
    >
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">
            Subscribers
          </p>
          <p class="text-2xl font-bold text-white mt-1">
            <%= youtubeData.subscriberCount %>
          </p>
        </div>
        <div
          class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center hidden sm:flex"
        >
          <i class="ti ti-user text-red-400 text-xl"></i>
        </div>
      </div>
    </div>

    <!-- Videos Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg hover:shadow-xl transition-shadow"
    >
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">
            Total Videos
          </p>
          <p class="text-2xl font-bold text-white mt-1">
            <%= youtubeData.videoCount %>
          </p>
        </div>
        <div
          class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center hidden sm:flex"
        >
          <i class="ti ti-video text-blue-400 text-xl"></i>
        </div>
      </div>
    </div>

    <!-- Views Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg hover:shadow-xl transition-shadow"
    >
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">
            Total Views
          </p>
          <p class="text-2xl font-bold text-white mt-1">
            <span class="text-gray-100"
              ><%= youtubeData.viewCount.toLocaleString('id-ID') %></span
            >
          </p>
        </div>
        <div
          class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center hidden sm:flex"
        >
          <i class="ti ti-eye text-green-400 text-xl"></i>
        </div>
      </div>
    </div>

    <!-- Channel Age Card -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg hover:shadow-xl transition-shadow"
    >
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-400 uppercase tracking-wide">
            Channel Age
          </p>
          <p class="text-lg font-bold text-white mt-1">
            <% const channelAge = Math.floor((new Date() - new
            Date(youtubeData.publishedAt)) / (1000 * 60 * 60 * 24)); %> <%=
            Math.floor(channelAge / 365) %> years
          </p>
        </div>
        <div
          class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center hidden sm:flex"
        >
          <i class="ti ti-calendar text-purple-400 text-xl"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Channel Details Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Channel Information -->
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg"
    >
      <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
        <i class="ti ti-info-circle mr-2 text-blue-400"></i>
        Channel Information
      </h3>
      <div class="space-y-4">
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base">Channel Name</span>
          <span class="text-white font-medium mt-1 sm:mt-0"
            ><%= youtubeData.title %></span
          >
        </div>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base">Channel ID</span>
          <span class="text-white font-medium font-mono text-sm mt-1 sm:mt-0"
            ><%= youtubeData.channelId %></span
          >
        </div>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base">Published Date</span>
          <span class="text-white font-medium mt-1 sm:mt-0"
            ><%= new Date(youtubeData.publishedAt).toLocaleDateString() %></span
          >
        </div>
        <% if (youtubeData.country) { %>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base">Country</span>
          <span class="text-white font-medium mt-1 sm:mt-0"
            ><%= youtubeData.country %></span
          >
        </div>
        <% } %> <% if (youtubeData.customUrl) { %>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base">Custom URL</span>
          <a
            href="https://www.youtube.com/<%= youtubeData.customUrl %>"
            target="_blank"
            class="text-blue-400 hover:text-blue-300 font-medium mt-1 sm:mt-0"
          >
            <%= youtubeData.customUrl %>
            <i class="ti ti-external-link ml-1"></i>
          </a>
        </div>
        <% } %>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2 border-b border-gray-700"
        >
          <span class="text-gray-400 text-sm sm:text-base"
            >Verification Status</span
          >
          <span class="mt-1 sm:mt-0">
            <% if (youtubeData.isVerified) { %>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-900/50 text-blue-300 border border-blue-700"
            >
              <i class="ti ti-badge-check-filled mr-1"></i>Verified
            </span>
            <% } else { %>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-700/50 text-gray-300 border border-gray-600"
            >
              <i class="ti ti-x mr-1"></i>Not Verified
            </span>
            <% } %>
          </span>
        </div>
        <% if (youtubeData.monetizationStatus) { %>
        <div
          class="flex flex-col sm:flex-row sm:justify-between sm:items-center py-2"
        >
          <span class="text-gray-400 text-sm sm:text-base">Monetization</span>
          <span class="mt-1 sm:mt-0">
            <% if (youtubeData.monetizationStatus ===
            'MONETIZATION_STATUS_ENABLED') { %>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-700"
            >
              <i class="ti ti-coin mr-1"></i>Enabled
            </span>
            <% } else { %>
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-700"
            >
              <i class="ti ti-alert-circle mr-1"></i>Not Enabled
            </span>
            <% } %>
          </span>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Channel Description -->
    <% if (youtubeData.description) { %>
    <div
      class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-6 border border-gray-700 shadow-lg"
    >
      <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
        <i class="ti ti-file-description mr-2 text-green-400"></i>
        Channel Description
      </h3>
      <div
        class="text-gray-300 text-sm leading-relaxed min-h-70 max-h-80 overflow-y-auto whitespace-pre-line break-words"
      >
        <%- youtubeData.description.replace(/\n/g, '<br />') %>
      </div>
    </div>
    <% } %>
  </div>

  <% } else { %>
  <!-- No Data State -->
  <div class="text-center py-12">
    <div class="flex justify-center mb-4">
      <i class="ti ti-brand-youtube text-red-400 text-5xl"></i>
    </div>
    <h3 class="text-lg font-semibold text-white mb-2">
      No YouTube Data Available
    </h3>
    <p class="text-gray-400 mb-6">
      Unable to fetch channel analytics. Please check your OAuth connection.
    </p>
    <button
      onclick="refreshYouTubeData()"
      class="inline-flex items-center px-6 py-3 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition-colors shadow"
    >
      <i class="ti ti-refresh mr-2"></i>
      Refresh Data
    </button>
  </div>
  <% } %>
</div>

<% } else { %>
<!-- OAuth Not Connected State -->
<div class="text-center py-12">
  <div class="flex justify-center mb-4">
    <i class="ti ti-plug text-gray-400 text-5xl"></i>
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">OAuth Not Connected</h3>
  <p class="text-gray-400 mb-6">
    Connect your YouTube account to view channel analytics and manage content.
  </p>
  <button
    onclick="switchTab('oauth')"
    class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors shadow"
  >
    <i class="ti ti-settings mr-2"></i>
    Go to OAuth Settings
  </button>
</div>
<% } %>
