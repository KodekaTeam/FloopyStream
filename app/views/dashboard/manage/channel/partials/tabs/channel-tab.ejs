<% if (channel.channel_platform !== 'youtube') { %>
<!-- Platform Not Supported State -->
<div class="text-center py-12">
  <div class="flex justify-center mb-4">
    <i class="ti ti-alert-circle text-yellow-400 text-5xl"></i>
  </div>
  <h3 class="text-lg font-semibold text-white mb-2">Fitur Tidak Tersedia</h3>
  <p class="text-gray-400 mb-6">
    Fitur ini hanya untuk YouTube. Platform yang Anda gunakan saat ini tidak
    mendukung fitur analitik channel.
  </p>
</div>
<% } else if (channel.channel_platform === 'youtube' && oauth && oauth.length >
0) { %>
<!-- Channel Analytics Section -->
<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="ti ti-brand-youtube text-red-500 mr-3"></i>
        Channel Analytics
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        YouTube channel performance and statistics
      </p>
    </div>
    <button
      onclick="refreshYouTubeData()"
      class="inline-flex items-center px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-semibold transition-all duration-300 shadow-lg shadow-red-600/20"
    >
      <i class="ti ti-refresh mr-2"></i>
      Refresh Data
    </button>
  </div>

  <% if (youtubeData) { %>
  <!-- Channel Header Card -->
  <div
    class="bg-gray-800/40 rounded-2xl p-6 border border-gray-700/50 flex flex-col sm:flex-row sm:items-center gap-6"
  >
    <img
      src="<%= youtubeData.thumbnailUrl %>"
      alt="Channel Thumbnail"
      class="w-20 h-20 rounded-2xl border-2 border-gray-700/50 shadow-sm mx-auto sm:mx-0 object-cover"
    />
    <div class="flex-1 min-w-0 text-center sm:text-left">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-3">
        <h3 class="text-xl sm:text-2xl font-bold text-white truncate">
          <a
            href="https://www.youtube.com/channel/<%= youtubeData.channelId %>"
            target="_blank"
            class="hover:text-red-400 transition-colors"
          >
            <%= youtubeData.title %>
            <i class="ti ti-external-link text-sm text-gray-500 ml-1"></i>
          </a>
        </h3>
        <% if (youtubeData.isVerified) { %>
        <div
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-900/20 border border-blue-800/30 self-center sm:self-auto"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
          <span
            class="text-[10px] font-bold text-blue-400 uppercase tracking-widest"
            >Verified</span
          >
        </div>
        <% } %>
      </div>
      <div
        class="flex flex-wrap justify-center sm:justify-start items-center gap-4"
      >
        <div class="flex items-center gap-2 text-sm text-gray-400 font-medium">
          <i class="ti ti-users text-red-500/70"></i>
          <span><%= youtubeData.subscriberCount %> Subscribers</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400 font-medium">
          <i class="ti ti-coin text-green-500/70"></i>
          <span
            class="<%= youtubeData.monetizationStatus === 'MONETIZATION_STATUS_ENABLED' ? 'text-green-400' : 'text-yellow-400' %>"
          >
            <%= youtubeData.monetizationStatus === 'MONETIZATION_STATUS_ENABLED'
            ? 'Monetized' : 'Not Monetized' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Subscribers Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl p-6 transition-all duration-300"
    >
      <div class="flex flex-col gap-1">
        <span
          class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
          >Subscribers</span
        >
        <div class="flex items-center justify-between mt-1">
          <span class="text-2xl font-bold text-white"
            ><%= youtubeData.subscriberCount %></span
          >
          <div
            class="w-10 h-10 rounded-xl bg-gray-900 border border-gray-700/50 flex items-center justify-center text-red-500 transition-all group-hover:border-red-500/30"
          >
            <i class="ti ti-users text-xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Videos Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl p-6 transition-all duration-300"
    >
      <div class="flex flex-col gap-1">
        <span
          class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
          >Videos</span
        >
        <div class="flex items-center justify-between mt-1">
          <span class="text-2xl font-bold text-white"
            ><%= youtubeData.videoCount %></span
          >
          <div
            class="w-10 h-10 rounded-xl bg-gray-900 border border-gray-700/50 flex items-center justify-center text-blue-500 transition-all group-hover:border-blue-500/30"
          >
            <i class="ti ti-video text-xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Views Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl p-6 transition-all duration-300"
    >
      <div class="flex flex-col gap-1">
        <span
          class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
          >Total Views</span
        >
        <div class="flex items-center justify-between mt-1">
          <span class="text-2xl font-bold text-white"
            ><%= youtubeData.viewCount.toLocaleString('id-ID') %></span
          >
          <div
            class="w-10 h-10 rounded-xl bg-gray-900 border border-gray-700/50 flex items-center justify-center text-green-500 transition-all group-hover:border-green-500/30"
          >
            <i class="ti ti-eye text-xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Channel Age Card -->
    <div
      class="group bg-gray-800/40 hover:bg-gray-800/60 border border-gray-700/50 rounded-2xl p-6 transition-all duration-300"
    >
      <div class="flex flex-col gap-1">
        <span
          class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
          >Channel Age</span
        >
        <div class="flex items-center justify-between mt-1">
          <% const channelAge = Math.floor((new Date() - new
          Date(youtubeData.publishedAt)) / (1000 * 60 * 60 * 24)); %>
          <span class="text-2xl font-bold text-white"
            ><%= Math.floor(channelAge / 365) %>y</span
          >
          <div
            class="w-10 h-10 rounded-xl bg-gray-900 border border-gray-700/50 flex items-center justify-center text-purple-500 transition-all group-hover:border-purple-500/30"
          >
            <i class="ti ti-calendar text-xl"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Channel Details Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Channel Information -->
    <div class="bg-gray-800/40 rounded-2xl p-6 border border-gray-700/50">
      <h3
        class="text-sm font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-3"
      >
        <div
          class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center"
        >
          <i class="ti ti-info-circle text-blue-500"></i>
        </div>
        Channel Information
      </h3>
      <div class="space-y-4">
        <div
          class="flex items-center justify-between pb-4 border-b border-gray-700/30"
        >
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Channel Name</span
          >
          <span class="text-sm font-semibold text-gray-200 text-right"
            ><%= youtubeData.title %></span
          >
        </div>
        <div
          class="flex items-center justify-between pb-4 border-b border-gray-700/30"
        >
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Channel ID</span
          >
          <span class="text-sm font-semibold text-gray-200 font-mono text-right"
            ><%= youtubeData.channelId %></span
          >
        </div>
        <div
          class="flex items-center justify-between pb-4 border-b border-gray-700/30"
        >
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Published</span
          >
          <span class="text-sm font-semibold text-gray-200 text-right"
            ><%= new Date(youtubeData.publishedAt).toLocaleDateString(undefined,
            { year: 'numeric', month: 'short', day: 'numeric' }) %></span
          >
        </div>
        <% if (youtubeData.country) { %>
        <div
          class="flex items-center justify-between pb-4 border-b border-gray-700/30"
        >
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Country</span
          >
          <span class="text-sm font-semibold text-gray-200 text-right"
            ><%= youtubeData.country %></span
          >
        </div>
        <% } %>
        <div
          class="flex items-center justify-between pb-4 border-b border-gray-700/30"
        >
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Verified Status</span
          >
          <% if (youtubeData.isVerified) { %>
          <div
            class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-900/20 border border-blue-800/30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            <span
              class="text-[10px] font-bold text-blue-400 uppercase tracking-widest"
              >Verified</span
            >
          </div>
          <% } else { %>
          <div
            class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-900/60 border border-gray-700/50"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
            <span
              class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
              >Not Verified</span
            >
          </div>
          <% } %>
        </div>
        <% if (youtubeData.monetizationStatus) { %>
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"
            >Monetization</span
          >
          <% if (youtubeData.monetizationStatus ===
          'MONETIZATION_STATUS_ENABLED') { %>
          <div
            class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-900/20 border border-green-800/30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            <span
              class="text-[10px] font-bold text-green-500 uppercase tracking-widest"
              >Enabled</span
            >
          </div>
          <% } else { %>
          <div
            class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-yellow-900/20 border border-yellow-800/30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
            <span
              class="text-[10px] font-bold text-yellow-500 uppercase tracking-widest"
              >Disabled</span
            >
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Channel Description -->
    <% if (youtubeData.description) { %>
    <div class="bg-gray-800/40 rounded-2xl p-6 border border-gray-700/50">
      <h3
        class="text-sm font-bold text-white mb-6 uppercase tracking-widest flex items-center gap-3"
      >
        <div
          class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center"
        >
          <i class="ti ti-file-description text-green-500"></i>
        </div>
        Channel Description
      </h3>
      <div
        class="text-gray-400 text-sm leading-relaxed max-h-[300px] overflow-y-auto whitespace-pre-line break-words custom-scrollbar pr-2"
      >
        <%- youtubeData.description.replace(/\n/g, '<br />') %>
      </div>
    </div>
    <% } %>
  </div>

  <% } else { %>
  <!-- No Data State -->
  <div
    class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
  >
    <div
      class="w-20 h-20 rounded-2xl bg-red-500/10 flex items-center justify-center mx-auto mb-6"
    >
      <i class="ti ti-brand-youtube text-red-500 text-4xl"></i>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">No YouTube Data Available</h3>
    <p class="text-gray-400 mb-8 max-w-sm mx-auto">
      Unable to fetch channel analytics. Please check your OAuth connection.
    </p>
    <button
      onclick="refreshYouTubeData()"
      class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-red-600/20"
    >
      <i class="ti ti-refresh mr-2"></i>
      Refresh Data
    </button>
  </div>
  <% } %>
</div>

<% } else { %>
<!-- OAuth Not Connected State -->
<div
  class="bg-gray-800/40 rounded-3xl p-12 border border-gray-700/50 text-center"
>
  <div
    class="w-20 h-20 rounded-2xl bg-gray-700/30 flex items-center justify-center mx-auto mb-6"
  >
    <i class="ti ti-plug text-gray-500 text-4xl"></i>
  </div>
  <h3 class="text-xl font-bold text-white mb-2">OAuth Not Connected</h3>
  <p class="text-gray-400 mb-8 max-w-sm mx-auto">
    Connect your YouTube account to view channel analytics and manage content.
  </p>
  <button
    onclick="switchTab('oauth')"
    class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-bold transition-all duration-300 shadow-lg shadow-blue-600/20"
  >
    <i class="ti ti-settings mr-2"></i>
    Go to OAuth Settings
  </button>
</div>
<% } %>
