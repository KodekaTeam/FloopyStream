<% layout('dashboard/layout') %>
<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %> <%- include('../../partials/sidebar')
  %>
  <div class="flex-1 overflow-auto lg:ml-20 pt-[72px]">
    <div class="p-4 sm:p-6 lg:p-8">
      <!-- Header with Back Button -->
      <div class="mb-8">
        <div
          class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
        >
          <div class="flex items-center gap-5">
            <a
              href="/playlists"
              class="w-11 h-11 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all duration-300 shadow-sm"
            >
              <i class="ti ti-arrow-left text-xl"></i>
            </a>
            <div class="min-w-0">
              <h1 class="text-2xl sm:text-3xl font-bold text-white truncate">
                <%= playlist.playlist_name %>
              </h1>
              <p class="text-gray-500 text-sm max-w-2xl line-clamp-1 mt-1">
                <%= playlist.description || 'Manage videos in this playlist' %>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button
              onclick="openAddVideosModal()"
              class="flex-1 sm:flex-none inline-flex items-center justify-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 rounded-xl text-sm font-semibold text-white transition-all duration-300 shadow-lg shadow-blue-600/20"
            >
              <i class="ti ti-plus mr-2"></i>
              <span>Add Videos</span>
            </button>
          </div>
        </div>

        <!-- Stats Overview -->
        <div
          class="flex flex-wrap items-center gap-4 sm:gap-6 mt-8 pt-6 border-t border-gray-800/50"
        >
          <div
            class="flex items-center gap-2 text-sm text-gray-400 font-medium"
          >
            <div class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></div>
            <span
              ><i class="ti ti-video opacity-70"></i> <%= videos &&
              videos.length || 0 %> Videos</span
            >
          </div>
          <% if (typeof totalDuration !== 'undefined' && totalDuration) { %>
          <div
            class="flex items-center gap-2 text-sm text-gray-400 font-medium"
          >
            <div class="w-1.5 h-1.5 rounded-full bg-purple-500/50"></div>
            <span
              ><i class="ti ti-clock opacity-70"></i> <%=
              Math.floor(totalDuration / 60) %> Minutes Total</span
            >
          </div>
          <% } %>
          <div
            class="flex items-center gap-2 text-sm text-gray-400 font-medium"
          >
            <div class="w-1.5 h-1.5 rounded-full bg-green-500/50"></div>
            <span class="uppercase tracking-wider text-[10px] font-bold"
              ><%= playlist.playback_mode || 'loop' %> Mode</span
            >
          </div>
        </div>
      </div>

      <div
        class="bg-gray-800/40 border border-gray-700/50 rounded-2xl overflow-hidden backdrop-blur-sm"
      >
        <% if (!videos || videos.length === 0) { %>
        <div class="p-20 text-center">
          <div
            class="w-20 h-20 bg-gray-800/50 rounded-full flex items-center justify-center mx-auto mb-6 border border-gray-800"
          >
            <i class="ti ti-video-off text-4xl text-gray-600"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">
            No Videos in Playlist
          </h3>
          <p
            class="text-gray-500 mb-8 max-w-sm mx-auto text-sm leading-relaxed"
          >
            This playlist is currently empty. Add some videos from your gallery
            to start building your sequence.
          </p>
          <button
            onclick="openAddVideosModal()"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-xl transition-all font-semibold shadow-lg shadow-blue-600/20"
          >
            <i class="ti ti-plus"></i>
            <span>Add Videos</span>
          </button>
        </div>
        <% } else { %>
        <div id="videosList" class="divide-y divide-gray-700/30">
          <% videos.forEach(function(video, index) { %>
          <div
            class="p-4 sm:p-5 hover:bg-gray-700/30 transition-all duration-300 group flex items-start sm:items-center gap-4 sm:gap-6"
            data-video-id="<%= video.video_uuid %>"
            data-item-uuid="<%= video.item_uuid || video.item_uuid %>"
            data-order-index="<%= video.order_index %>"
          >
            <!-- Drag Handle & Index (Left Side) -->
            <div class="flex flex-col items-center gap-3 shrink-0 pt-2 sm:pt-0">
              <div
                class="flex items-center text-gray-600 hover:text-blue-400 cursor-grab active:cursor-grabbing transition-colors"
                title="Drag to reorder"
              >
                <i class="ti ti-grip-vertical text-xl sm:text-2xl"></i>
              </div>
              <span class="text-gray-500 font-bold text-[10px] sm:text-xs">
                <%= String(index + 1).padStart(2, '0') %>
              </span>
            </div>

            <!-- Content Body: Stacked on Mobile (Card Style), Row on Desktop -->
            <div
              class="flex-1 flex flex-col sm:flex-row gap-4 sm:gap-6 min-w-0"
            >
              <!-- Thumbnail -->
              <div
                class="w-full sm:w-40 lg:w-48 aspect-video bg-gray-950 rounded-xl overflow-hidden flex-shrink-0 border border-gray-700/50 group-hover:border-blue-500/30 transition-all shadow-lg"
              >
                <% if (video.thumbnail_path) { %>
                <img
                  src="<%= getThumbnailUrl(video.thumbnail_path) %>"
                  alt="<%= video.video_title %>"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  onerror="this.onerror=null;this.src='/images/default-thumb.png';"
                />
                <% } else { %>
                <div
                  class="w-full h-full flex items-center justify-center bg-gray-800/50"
                >
                  <i class="ti ti-video text-2xl sm:text-3xl text-gray-700"></i>
                </div>
                <% } %>
              </div>

              <!-- Video Info -->
              <div class="flex-1 min-w-0 flex flex-col justify-center">
                <h4
                  class="text-white font-bold text-base sm:text-lg mb-2 truncate group-hover:text-blue-400 transition-colors"
                >
                  <%= video.video_title %>
                </h4>

                <div class="flex flex-wrap items-center gap-4">
                  <% if (video.duration_seconds) { %>
                  <div
                    class="flex items-center gap-2 px-2 py-1 bg-blue-500/5 rounded-lg border border-blue-500/10 text-[10px] sm:text-xs font-bold text-gray-400 uppercase tracking-wider"
                  >
                    <i class="ti ti-clock text-blue-500/70"></i>
                    <span
                      ><%= Math.floor(video.duration_seconds / 60) %>:<%=
                      String(Math.floor(video.duration_seconds %
                      60)).padStart(2, '0') %></span
                    >
                  </div>
                  <% } %> <% if (video.filesize) { %>
                  <div
                    class="flex items-center gap-2 px-2 py-1 bg-purple-500/5 rounded-lg border border-purple-500/10 text-[10px] sm:text-xs font-bold text-gray-400 uppercase tracking-wider"
                  >
                    <i class="ti ti-device-floppy text-purple-500/70"></i>
                    <span
                      ><%= (video.filesize / (1024 * 1024)).toFixed(1) %>
                      MB</span
                    >
                  </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Actions (Right Side) -->
            <div
              class="flex flex-col sm:flex-row items-center gap-2 lg:opacity-0 group-hover:opacity-100 transition-all duration-300 shrink-0 pt-2 sm:pt-0"
            >
              <div
                class="flex flex-col sm:flex-row bg-gray-900/50 rounded-xl border border-gray-700/50 overflow-hidden"
              >
                <% if (index > 0) { %>
                <button
                  onclick="moveVideo('<%= video.video_uuid %>', 'up')"
                  class="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700 transition-all"
                  title="Move up"
                >
                  <i class="ti ti-arrow-up text-sm"></i>
                </button>
                <% } %>

                <div
                  class="w-full h-px sm:w-px sm:h-4 bg-gray-700/50 self-center"
                ></div>

                <% if (index < videos.length - 1) { %>
                <button
                  onclick="moveVideo('<%= video.video_uuid %>', 'down')"
                  class="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-gray-700 transition-all"
                  title="Move down"
                >
                  <i class="ti ti-arrow-down text-sm"></i>
                </button>
                <% } %>
              </div>

              <button
                onclick="removeFromPlaylist('<%= video.video_uuid %>')"
                class="w-10 h-10 flex items-center justify-center bg-red-500/10 text-red-500/70 hover:text-red-500 hover:bg-red-500/20 border border-red-500/20 rounded-xl transition-all"
                title="Remove from playlist"
              >
                <i class="ti ti-trash text-sm"></i>
              </button>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Add Videos Modal -->
<div
  id="addVideosModal"
  class="fixed inset-0 bg-gray-950/80 backdrop-blur-sm z-[60] hidden flex items-center justify-center p-4"
>
  <div
    class="bg-gray-900 border border-gray-800 rounded-3xl w-full max-w-5xl max-h-[85vh] overflow-hidden flex flex-col shadow-2xl"
  >
    <div
      class="flex items-center justify-between p-4 sm:p-6 border-b border-gray-800"
    >
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-white">
          Add Videos to Playlist
        </h3>
        <p class="text-[10px] sm:text-xs text-gray-500 mt-0.5 sm:mt-1">
          Select videos from your gallery to add them to this playlist
        </p>
      </div>
      <button
        onclick="closeAddVideosModal()"
        class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all"
      >
        <i class="ti ti-x text-lg sm:text-xl"></i>
      </button>
    </div>

    <div class="p-4 sm:p-6 overflow-y-auto custom-scrollbar">
      <div
        id="availableVideos"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
      >
        <% const playlistVideoUuids = new Set((videos || []).map(v =>
        v.video_uuid)); (allVideos || []).forEach(function(video) { const
        alreadyInPlaylist = playlistVideoUuids.has(video.video_uuid); %>
        <label
          for="video-<%= video.video_uuid %>"
          class="relative bg-gray-800/40 rounded-2xl overflow-hidden border border-gray-700/50 group transition-all duration-300 flex flex-col <%= alreadyInPlaylist ? 'opacity-60 grayscale cursor-not-allowed' : 'hover:border-blue-500/50 hover:bg-gray-800/60 cursor-pointer' %>"
        >
          <div class="aspect-video bg-gray-950 relative overflow-hidden">
            <% if (video.thumbnail_path) { %>
            <img
              src="<%= getThumbnailUrl(video.thumbnail_path) %>"
              alt="<%= video.video_title %>"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              onerror="this.onerror=null;this.src='/images/default-thumb.png';"
            />
            <% } else { %>
            <div class="w-full h-full flex items-center justify-center">
              <i class="ti ti-video text-3xl text-gray-800"></i>
            </div>
            <% } %>

            <div class="absolute top-3 right-3 z-10">
              <input type="checkbox" id="video-<%= video.video_uuid %>"
              class="sr-only video-checkbox" onchange="updateModalUI('<%=
              video.video_uuid %>', this.checked)" <%= alreadyInPlaylist ?
              'disabled checked' : '' %> />
              <div
                class="w-6 h-6 rounded-lg border-2 border-white/20 bg-black/40 backdrop-blur-sm flex items-center justify-center transition-all duration-300 group-hover:border-blue-500 <%= alreadyInPlaylist ? 'bg-blue-600 border-blue-600' : '' %>"
                id="check-container-<%= video.video_uuid %>"
              >
                <i
                  class="ti ti-check text-white text-sm <%= alreadyInPlaylist ? '' : 'hidden' %>"
                  id="check-icon-<%= video.video_uuid %>"
                ></i>
              </div>
            </div>

            <% if (video.duration_seconds) { %>
            <div
              class="absolute bottom-2 right-2 bg-black/70 backdrop-blur-md px-1.5 py-0.5 rounded text-[10px] font-bold text-white border border-white/10"
            >
              <%= Math.floor(video.duration_seconds / 60) %>:<%=
              String(Math.floor(video.duration_seconds % 60)).padStart(2, '0')
              %>
            </div>
            <% } %>
          </div>

          <div class="p-4">
            <p
              class="text-white text-sm font-bold truncate group-hover:text-blue-400 transition-colors"
            >
              <%= video.video_title %>
            </p>
            <div class="flex items-center gap-2 mt-1">
              <% if (alreadyInPlaylist) { %>
              <span
                class="text-[10px] uppercase tracking-wider font-bold text-blue-500"
                >Already in playlist</span
              >
              <% } else { %>
              <span
                class="text-[10px] uppercase tracking-wider font-bold text-gray-500"
                ><%= (video.filesize / (1024 * 1024)).toFixed(1) %> MB</span
              >
              <% } %>
            </div>
          </div>
        </label>
        <% }); %>
      </div>
    </div>

    <div
      class="p-4 sm:p-6 border-t border-gray-800 bg-gray-900/50 backdrop-blur-md"
    >
      <div class="flex items-center justify-between gap-4">
        <p class="text-gray-500 text-xs sm:text-sm hidden xs:block">
          <span id="selectedCount" class="text-blue-500 font-bold">0</span>
          videos selected
        </p>
        <div class="flex gap-2 sm:gap-3 w-full sm:w-auto">
          <button
            onclick="closeAddVideosModal()"
            class="flex-1 sm:flex-none bg-gray-800 hover:bg-gray-700 text-white px-4 sm:px-8 py-2.5 sm:py-3 rounded-xl transition-all text-sm sm:text-base font-semibold border border-gray-700/50"
          >
            Cancel
          </button>
          <button
            onclick="addSelectedVideos()"
            id="addSelectedBtn"
            class="flex-1 sm:flex-none bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-4 sm:px-8 py-2.5 sm:py-3 rounded-xl transition-all text-sm sm:text-base font-semibold shadow-lg shadow-blue-600/20"
            disabled
          >
            Add Selected
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
  const playlistId = "<%= playlist.playlist_uuid || playlist.playlist_id %>";
</script>
<script src="/js/playlist-detail.js"></script>

