<% layout('dashboard/layout') %>

<div class="flex h-screen bg-gray-900 overflow-hidden">
  <%- include('../../partials/navbar') %> <%- include('../../partials/sidebar')
  %>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto lg:ml-20 pt-[72px]">
    <div class="p-4 sm:p-6 lg:p-8">
      <!-- Header -->
      <div class="mb-8">
        <div
          class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
        >
          <div class="flex items-center gap-5">
            <div
              class="w-12 h-12 flex items-center justify-center bg-blue-500/10 rounded-2xl border border-blue-500/20"
            >
              <i class="ti ti-users text-2xl text-blue-500"></i>
            </div>
            <div class="min-w-0">
              <h1 class="text-2xl sm:text-3xl font-bold text-white">
                User Management
              </h1>
              <p class="text-gray-500 text-sm sm:text-base mt-1">
                Manage user accounts and permissions
              </p>
            </div>
          </div>

          <button
            onclick="openCreateUserModal()"
            class="inline-flex items-center justify-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 rounded-xl text-sm font-semibold text-white transition-all duration-300 shadow-lg shadow-blue-600/20"
          >
            <i class="ti ti-plus mr-2"></i>
            <span>Create New User</span>
          </button>
        </div>
      </div>

      <!-- Stats Overview -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
        <div
          class="relative group bg-gray-800/40 backdrop-blur-sm p-5 sm:p-6 rounded-2xl border border-gray-700/50 hover:border-blue-500/30 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <div
              class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500"
            >
              <i class="ti ti-users text-xl"></i>
            </div>
            <span
              class="text-[10px] font-bold text-blue-500/50 uppercase tracking-widest leading-none"
              >Total</span
            >
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-white" id="totalUsers">
            0
          </p>
          <p class="text-gray-500 text-xs mt-1">Registered users</p>
        </div>

        <div
          class="relative group bg-gray-800/40 backdrop-blur-sm p-5 sm:p-6 rounded-2xl border border-gray-700/50 hover:border-green-500/30 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <div
              class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center text-green-500"
            >
              <i class="ti ti-user-check text-xl"></i>
            </div>
            <span
              class="text-[10px] font-bold text-green-500/50 uppercase tracking-widest leading-none"
              >Active</span
            >
          </div>
          <p
            class="text-2xl sm:text-3xl font-bold text-green-400"
            id="activeUsers"
          >
            0
          </p>
          <p class="text-gray-500 text-xs mt-1">Currently active</p>
        </div>

        <div
          class="relative group bg-gray-800/40 backdrop-blur-sm p-5 sm:p-6 rounded-2xl border border-gray-700/50 hover:border-purple-500/30 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <div
              class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-500"
            >
              <i class="ti ti-shield text-xl"></i>
            </div>
            <span
              class="text-[10px] font-bold text-purple-500/50 uppercase tracking-widest leading-none"
              >Admins</span
            >
          </div>
          <p
            class="text-2xl sm:text-3xl font-bold text-blue-400"
            id="adminUsers"
          >
            0
          </p>
          <p class="text-gray-500 text-xs mt-1">System administrators</p>
        </div>

        <div
          class="relative group bg-gray-800/40 backdrop-blur-sm p-5 sm:p-6 rounded-2xl border border-gray-700/50 hover:border-orange-500/30 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <div
              class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500"
            >
              <i class="ti ti-user-circle text-xl"></i>
            </div>
            <span
              class="text-[10px] font-bold text-orange-500/50 uppercase tracking-widest leading-none"
              >Members</span
            >
          </div>
          <p
            class="text-2xl sm:text-3xl font-bold text-gray-300"
            id="memberUsers"
          >
            0
          </p>
          <p class="text-gray-500 text-xs mt-1">Regular members</p>
        </div>
      </div>

      <!-- Search and Filters -->
      <div class="mb-8 flex flex-col md:flex-row gap-4 items-center">
        <div class="relative w-full md:flex-1">
          <i
            class="ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg"
          ></i>
          <input
            type="text"
            id="searchUsers"
            placeholder="Search by username or ID..."
            class="w-full bg-gray-800/40 border border-gray-700/50 rounded-xl pl-11 pr-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-all backdrop-blur-sm"
            oninput="filterUsers()"
          />
        </div>
        <div class="flex gap-4 w-full md:w-auto">
          <select
            id="filterRole"
            class="flex-1 md:w-40 bg-gray-800/40 border border-gray-700/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-all backdrop-blur-sm cursor-pointer"
            onchange="filterUsers()"
          >
            <option value="all">All Roles</option>
            <option value="admin">Admin</option>
            <option value="member">Member</option>
          </select>
          <select
            id="filterStatus"
            class="flex-1 md:w-40 bg-gray-800/40 border border-gray-700/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-all backdrop-blur-sm cursor-pointer"
            onchange="filterUsers()"
          >
            <option value="all">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
      </div>

      <!-- Users Table -->
      <div
        class="bg-gray-800/40 border border-gray-700/50 rounded-2xl overflow-hidden backdrop-blur-sm"
      >
        <div
          class="p-5 sm:p-6 border-b border-gray-700/50 flex items-center justify-between"
        >
          <h3 class="font-bold text-white text-lg">Platform Users</h3>
          <span
            class="text-xs font-medium text-gray-500 uppercase tracking-wider"
            >Real-time Management</span
          >
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-gray-900/50">
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center"
                >
                  User Details
                </th>
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center border-l border-gray-700/30"
                >
                  Role & Access
                </th>
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center border-l border-gray-700/30"
                >
                  Status
                </th>
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center border-l border-gray-700/30 hidden md:table-cell"
                >
                  Usage
                </th>
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center border-l border-gray-700/30 hidden lg:table-cell"
                >
                  Registration
                </th>
                <th
                  class="px-6 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center border-l border-gray-700/30"
                >
                  Actions
                </th>
              </tr>
            </thead>
            <tbody id="usersTableBody" class="divide-y divide-gray-700/30">
              <tr>
                <td colspan="6" class="px-6 py-20 text-center">
                  <div class="flex flex-col items-center gap-3">
                    <i
                      class="ti ti-loader-2 animate-spin text-3xl text-blue-500/80"
                    ></i>
                    <p class="text-gray-500 font-medium">
                      Fetching user directory...
                    </p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div class="mt-4 space-y-3" id="paginationContainer">
        <div
          class="flex items-center justify-center gap-2 flex-wrap"
          id="paginationButtons"
        >
          <!-- Pagination buttons will be generated here -->
        </div>
        <p class="text-center text-sm text-gray-400" id="paginationInfo">
          <!-- Pagination info will be shown here -->
        </p>
      </div>
    </div>
  </main>
</div>

<!-- Create User Modal -->
<%- include('./modals/create-user') %>

<!-- Edit User Modal -->
<%- include('./modals/edit-user') %>

<!-- Delete Confirmation Modal -->
<%- include('./modals/delete-user') %>

<script src="/js/user-management.js"></script>

