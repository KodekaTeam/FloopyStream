<!-- Edit User Modal -->
<div
  id="editUserModal"
  class="fixed inset-0 z-[60] hidden flex items-center justify-center p-4 bg-gray-950/80 backdrop-blur-sm"
>
  <div
    class="bg-gray-900 border border-gray-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden"
  >
    <div class="flex items-center justify-between p-3 border-b border-gray-800">
      <div>
        <h3 class="text-md font-bold text-white">Edit User Access</h3>
        <p class="text-xs text-gray-500 mt-1">
          Modify account permissions and security
        </p>
      </div>
      <button
        onclick="closeEditUserModal()"
        class="w-10 h-10 flex items-center justify-center bg-gray-800/50 hover:bg-gray-800 border border-gray-700/50 text-gray-400 hover:text-white rounded-xl transition-all"
      >
        <i class="ti ti-x text-xl"></i>
      </button>
    </div>

    <div class="p-6 space-y-6">
      <input type="hidden" id="editUserId" />

      <div class="space-y-2">
        <label
          class="block text-xs font-bold text-gray-500 uppercase tracking-widest"
          >Global Permissions</label
        >
        <div class="relative">
          <i
            class="ti ti-shield absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg"
          ></i>
          <select
            id="editUserRole"
            class="w-full bg-gray-800/60 border border-gray-700/50 rounded-xl pl-11 pr-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:bg-gray-800 transition-all font-medium cursor-pointer appearance-none"
          >
            <option value="member">Member</option>
            <option value="admin">Administrator</option>
          </select>
        </div>
      </div>

      <div class="space-y-2">
        <label
          class="block text-xs font-bold text-gray-500 uppercase tracking-widest"
          >Update Security</label
        >
        <div class="relative group">
          <i
            class="ti ti-key absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg group-focus-within:text-blue-500 transition-colors"
          ></i>
          <input
            type="password"
            id="editUserPassword"
            minlength="6"
            class="w-full bg-gray-800/60 border border-gray-700/50 rounded-xl pl-11 pr-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:bg-gray-800 transition-all font-medium"
            placeholder="New password (optional)"
          />
        </div>
        <p class="text-[10px] text-gray-500 italic">
          Leave empty to keep current password.
        </p>
      </div>

      <div class="flex gap-3 pt-2">
        <button
          type="button"
          onclick="closeEditUserModal()"
          class="flex-1 bg-gray-800 hover:bg-gray-700 text-white px-4 py-3 rounded-xl transition-all font-bold text-sm border border-gray-700/50"
        >
          Cancel
        </button>
        <button
          type="button"
          onclick="saveUserChanges()"
          class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded-xl transition-all font-bold text-sm shadow-lg shadow-blue-600/20"
        >
          Save Changes
        </button>
      </div>
    </div>
  </div>
</div>
