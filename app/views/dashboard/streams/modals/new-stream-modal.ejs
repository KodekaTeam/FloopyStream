<script>
  function toggleRepeatOptions(isChecked) {
    const scheduleTime = document
      .getElementById("scheduledTimeInput")
      .value.trim();
    const duration = document
      .querySelector('input[name="duration"]')
      .value.trim();
    if (isChecked && (!scheduleTime || !duration)) {
      Swal.fire({
        toast: true,
        position: "top",
        icon: "warning",
        title: "Please fill in the schedule time and duration first!",
        showConfirmButton: false,
        timer: 2500, // Auto close after 2.5 seconds
        timerProgressBar: true,
      });
      // Reset checkbox
      document.querySelector('input[name="repeatStream"]').checked = false;
      return;
    }
    const repeatOptions = document.getElementById("repeatOptions");
    if (isChecked) {
      repeatOptions.classList.remove("hidden");
      repeatOptions.classList.add("animate-fade-in");
    } else {
      repeatOptions.classList.add("hidden");
      repeatOptions.classList.remove("animate-fade-in");
    }
  }

  // Add animation for details chevron
  document.addEventListener("DOMContentLoaded", function () {
    const details = document.getElementById("additionalSettingsDetails");
    details.addEventListener("toggle", function () {
      const chevron = this.querySelector(".ti-chevron-down");
      if (this.open) {
        chevron.style.transform = "rotate(180deg)";
      } else {
        chevron.style.transform = "rotate(0deg)";
      }
    });
  });

  // Add animation for details chevron
  document.addEventListener("DOMContentLoaded", function () {
    const details = document.getElementById("advancedSettingsDetails");
    details.addEventListener("toggle", function () {
      const chevron = this.querySelector(".ti-chevron-down");
      if (this.open) {
        chevron.style.transform = "rotate(180deg)";
      } else {
        chevron.style.transform = "rotate(0deg)";
      }
    });
  });
</script>

<script>
  function checkRepeatEligibility() {
    const scheduleTime = document
      .getElementById("scheduledTimeInput")
      .value.trim();
    const duration = document
      .querySelector('input[name="duration"]')
      .value.trim();
    const repeatCheckbox = document.querySelector('input[name="repeatStream"]');
    if (!scheduleTime || !duration) {
      repeatCheckbox.checked = false;
      toggleRepeatOptions(false);
    }
  }
  document
    .getElementById("scheduledTimeInput")
    .addEventListener("input", checkRepeatEligibility);
  document
    .querySelector('input[name="duration"]')
    .addEventListener("input", checkRepeatEligibility);
  document.addEventListener("DOMContentLoaded", checkRepeatEligibility);
</script>
