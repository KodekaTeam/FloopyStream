<% layout('dashboard/layout') %> <% if (!allowRegistration) { %>
<div
  class="closed-registration-container"
  style="
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 20px;
  "
>
  <div style="max-width: 500px; width: 100%">
    <div
      class="alert alert-warning"
      style="
        background-color: #fef3c7;
        border-color: #fcd34d;
        padding: 40px;
        border-radius: 12px;
      "
    >
      <div style="text-align: center">
        <i
          class="ti ti-lock-check"
          style="
            font-size: 64px;
            color: #d97706;
            margin-bottom: 16px;
            display: block;
          "
        ></i>
        <p
          style="
            font-size: 24px;
            font-weight: 700;
            color: #92400e;
            margin: 0 0 16px 0;
          "
        >
          Registration Closed
        </p>
        <p
          style="
            color: #b45309;
            margin: 12px 0;
            line-height: 1.6;
            font-size: 15px;
          "
        >
          An administrator account has already been created. New registrations
          are no longer available for security reasons.
        </p>
        <div
          style="
            margin-top: 32px;
            border-top: 1px solid #fcd34d;
            padding-top: 24px;
          "
        >
          <p
            style="
              color: #92400e;
              margin-bottom: 20px;
              font-weight: 500;
              font-size: 14px;
            "
          >
            If you have credentials, please log in:
          </p>
          <a
            href="/login"
            style="
              display: inline-block;
              background-color: #d97706;
              color: white;
              padding: 12px 32px;
              border-radius: 8px;
              text-decoration: none;
              font-weight: 600;
              transition: all 0.3s ease;
              font-size: 15px;
            "
          >
            <i class="ti ti-login" style="margin-right: 8px"></i>Go to Login
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
<% } else { %>
<div class="auth-container">
  <div class="auth-card">
    <h2>
      <img
        src="/images/favicon.ico"
        alt="Logo"
        class="w-16 h-16 inline-block align-middle mr-1"
      /><%= appName %>
      <p class="text-sm text-gray-500 mt-0">Sign up to manage your account.</p>
    </h2>

    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/register" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          class="form-control"
          required
          minlength="3"
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <div class="relative">
          <input
            type="password"
            id="registerPassword"
            name="password"
            class="form-control pr-10"
            required
            autocomplete="new-password"
          />
          <button
            type="button"
            onclick="togglePasswordVisibility('registerPassword','registerPasswordIcon')"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-600"
            tabindex="-1"
            style="background: none; border: none; padding: 0"
          >
            <i class="ti ti-eye" id="registerPasswordIcon"></i>
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <div class="relative">
          <input
            type="password"
            id="registerConfirmPassword"
            name="confirmPassword"
            class="form-control pr-10"
            required
            autocomplete="new-password"
          />
          <button
            type="button"
            onclick="togglePasswordVisibility('registerConfirmPassword','registerConfirmPasswordIcon')"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-600"
            tabindex="-1"
            style="background: none; border: none; padding: 0"
          >
            <i class="ti ti-eye" id="registerConfirmPasswordIcon"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Register</button>
    </form>

    <div class="auth-footer">
      <p>Already have an account? <a href="/login">Login here</a></p>
    </div>
  </div>
</div>
<% } %>
