<div
  class="bg-gray-800 rounded-lg overflow-hidden group hover:ring-0 hover:ring-blue-500 transition-all"
  data-broadcast-id="<%= broadcast.broadcast_id %>"
  data-broadcast-uuid="<%= broadcast.broadcast_uuid %>"
>
  <!-- Thumbnail with overlay -->
  <div
    class="relative w-full aspect-video overflow-hidden <%= broadcast.broadcast_type === 'playlist' ? 'bg-gradient-to-br from-purple-600 to-blue-600' : 'bg-gray-900' %>"
  >
    <% if (broadcast.thumbnail_path) { %>
    <img
      src="/storage/thumbnails/<%= broadcast.thumbnail_path %>"
      alt="<%= broadcast.broadcast_name || 'Untitled' %>"
      class="w-full h-full object-cover"
    />
    <% } else if (broadcast.broadcast_type === 'playlist') { %>
    <div class="w-full h-full flex items-center justify-center">
      <i class="ti ti-playlist text-6xl text-white opacity-90"></i>
    </div>
    <% } else { %>
    <div class="w-full h-full flex items-center justify-center">
      <i class="ti ti-video text-5xl text-gray-600"></i>
    </div>
    <% } %>

    <!-- Status Badge Overlay -->
    <div class="absolute top-2 right-2">
      <% if (broadcast.broadcast_status === 'active') { %>
      <span
        class="flex items-center gap-1.5 bg-red-600/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-medium"
      >
        <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
        LIVE NOW
      </span>
      <% } else if (broadcast.broadcast_status === 'scheduled') { %>
      <span
        class="bg-yellow-600/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-medium"
      >
        SCHEDULED
      </span>
      <% } else { %>
      <span
        class="bg-gray-600/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-medium"
      >
        <%= broadcast.broadcast_status.toUpperCase() %>
      </span>
      <% } %>
    </div>

    <!-- Hover Overlay with Quick Actions -->
    <div
      class="absolute inset-0 bg-black/30 opacity-60 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-4"
    >
      <% if (broadcast.broadcast_status === 'active') { %>
      <button
        onclick="stopBroadcast('<%= broadcast.broadcast_uuid %>')"
        class="w-10 h-10 flex items-center justify-center bg-red-600 hover:bg-red-700 rounded-full transition-colors"
        title="Stop Stream"
      >
        <i class="ti ti-player-stop text-white"></i>
      </button>
      <% } else { %>
      <button
        onclick="startBroadcast('<%= broadcast.broadcast_uuid %>')"
        class="w-10 h-10 flex items-center justify-center bg-green-600 hover:bg-green-700 rounded-full transition-colors"
        title="Start Stream"
      >
        <i class="ti ti-player-play text-white"></i>
      </button>
      <% } %>
      <button
        onclick="openEditStreamModal('<%= broadcast.broadcast_uuid %>')"
        class="w-10 h-10 flex items-center justify-center bg-blue-600 hover:bg-blue-700 rounded-full transition-colors"
        title="Edit"
      >
        <i class="ti ti-edit text-white"></i>
      </button>
      <button
        onclick="deleteBroadcast('<%= broadcast.broadcast_uuid %>')"
        class="w-10 h-10 flex items-center justify-center bg-gray-700 hover:bg-gray-600 rounded-full transition-colors"
        title="Delete"
      >
        <i class="ti ti-trash text-red-400"></i>
      </button>
    </div>
  </div>

  <!-- Card Content -->
  <div class="p-4">
    <h3
      class="font-semibold text-white mb-1 line-clamp-2 leading-snug min-h-[2.5rem]"
      title="<%= broadcast.broadcast_name || broadcast.stream_title || 'Untitled Broadcast' %>"
    >
      <%= broadcast.broadcast_name || broadcast.stream_title ||
      'Untitled-Broadcast' %>
    </h3>

    <!-- Content Info -->
    <% if (broadcast.broadcast_type === 'playlist' && broadcast.playlist_name) {
    %>
    <div class="flex items-center gap-1.5 text-xs text-blue-400 mb-2">
      <i class="ti ti-playlist"></i>
      <span><%= broadcast.playlist_name %></span>
      <% if (broadcast.playback_mode === 'shuffle') { %>
      <i class="ti ti-arrows-shuffle text-xs"></i>
      <% } %>
    </div>
    <% } else if (broadcast.content_title || broadcast.video_title) { %>
    <div class="flex items-center gap-1.5 text-xs text-gray-400 mb-2">
      <i class="ti ti-video"></i>
      <span class="truncate"
        ><%= broadcast.content_title || broadcast.video_title || 'Untitled'
        %></span
      >
    </div>
    <% } %>

    <!-- Details Grid -->
    <div class="grid grid-cols-2 gap-2 text-sm">
      <div class="bg-gray-700/50 p-2 rounded">
        <p class="text-gray-400 text-xs">Platform</p>
        <div class="flex items-center gap-1 text-gray-200 mt-0.5 truncate">
          <i class="ti ti-cast"></i>
          <span class="capitalize"
            ><%= broadcast.platform_name || 'Custom' %></span
          >
        </div>
      </div>
      <div class="bg-gray-700/50 p-2 rounded">
        <p class="text-gray-400 text-xs">Channel</p>
        <p class="text-gray-200 mt-0.5 truncate">
          <%= broadcast.channel_name || 'Unknown' %>
        </p>
      </div>
      <div class="bg-gray-700/50 p-2 rounded">
        <p class="text-gray-400 text-xs">Resolution</p>
        <p class="text-gray-200 m">
          <% if (broadcast.resolution) { %> <%= broadcast.resolution %> • <%=
          broadcast.bitrate || 'N/A' %> • <%= broadcast.frame_rate || 30 %> FPS
          <% } else { %> Auto-detect <% } %>
        </p>
      </div>
      <div class="bg-gray-700/50 p-2 rounded">
        <p class="text-gray-400 text-xs">Created</p>
        <p class="text-gray-200 mt-0.5 truncate">
          <%= broadcast.created_at ? (typeof formatTimestamp === 'function' ?
          formatTimestamp(broadcast.created_at, 'datetime') : new
          Date(broadcast.created_at).toLocaleString()) : '--' %>
        </p>
      </div>
    </div>
  </div>
</div>
